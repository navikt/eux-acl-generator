{
  "U026_Master": {
    "sedGVer": "$sedGVer",
    "sedVer": "$sedVer",
    "LocalCaseNumbers": {
      "LocalCaseNumber": [
        {
          "country": {
            "value": [
              "$nav.eessisak[x].land"
            ]
          },
          "caseNumber": "$nav.eessisak[x].saksnummer",
          "Institution": {
            "institutionID": "$nav.eessisak[x].institusjonsid",
            "institutionName": "$nav.eessisak[x].institusjonsnavn"
          }
        }
      ]
    },
    "InformationChargingInterest": {
      "reimbursementRequestID": "$dagpenger.refusjonskrav.id",
      "dueDate": "$dagpenger.refusjonskrav.forfallsdato",
      "TotalAmountOutstandingClaims": {
        "amount": "$dagpenger.refusjonskrav.beloep.totalbeloep",
        "currency": {
          "value": [
            "$dagpenger.refusjonskrav.beloep.valuta"
          ]
        }
      },
      "interestRate": "$dagpenger.refusjonskrav.rentebetaling.rentesats"
    }
  }
}
