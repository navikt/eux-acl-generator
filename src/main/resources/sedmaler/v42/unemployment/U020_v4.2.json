{
  "U020": {
    "sedGVer": "$sedGVer",
    "sedVer": "$sedVer",
    "LocalCaseNumbers": {
      "LocalCaseNumber": [
        {
          "country": {
            "value": [
              "$nav.eessisak[x].land"
            ]
          },
          "caseNumber": "$nav.eessisak[x].saksnummer",
          "Institution": {
            "institutionID": "$nav.eessisak[x].institusjonsid",
            "institutionName": "$nav.eessisak[x].institusjonsnavn"
          }
        }
      ]
    },
    "GeneralInformation": {
      "reimbursementRequestID": "$dagpenger.refusjonskrav.id",
      "numberIndividualClaims": "$dagpenger.refusjonskrav.antallkrav",
      "TotalAmountRequested": {
        "amount": "$dagpenger.refusjonskrav.anmodnettotalbeloep.beloep",
        "currency": {
          "value": [
            "$dagpenger.refusjonskrav.anmodnettotalbeloep.valuta"
          ]
        }
      },
      "BankInformation": {
        "SEPABankDetails": {
          "IBAN": "$dagpenger.refusjonskrav.bank.konto.sepa.iban",
          "BICSWIFT": "$dagpenger.refusjonskrav.bank.konto.sepa.swift"
        },
        "bankTransferSubjectOrTransactionReference": "$dagpenger.refusjonskrav.bank.overfoering.emneellerreferanse"
      }
    },
    "IndividualClaims": {
      "IndividualClaim": [
        {
          "Person": {
            "PersonIdentification": {
              "familyName": "$dagpenger.refusjonskrav.enkeltkrav[x].bruker.person.etternavn",
              "forename": "$dagpenger.refusjonskrav.enkeltkrav[x].bruker.person.fornavn",
              "dateBirth": "$dagpenger.refusjonskrav.enkeltkrav[x].bruker.person.foedselsdato",
              "sex": {
                "value": [
                  "$dagpenger.refusjonskrav.enkeltkrav[x].bruker.person.kjoenn"
                ]
              },
              "familyNameAtBirth": "$dagpenger.refusjonskrav.enkeltkrav[x].bruker.person.etternavnvedfoedsel",
              "forenameAtBirth": "$dagpenger.refusjonskrav.enkeltkrav[x].bruker.person.fornavnvedfoedsel",
              "PINPersonInEachInstitution": {
                "PersonalIdentificationNumber": [
                  {
                    "country": {
                      "value": [
                        "$dagpenger.refusjonskrav.enkeltkrav[x].bruker.person.pin[x].land"
                      ]
                    },
                    "personalIdentificationNumber": "$dagpenger.refusjonskrav.enkeltkrav[x].bruker.person.pin[x].identifikator",
                    "sector": {
                      "value": [
                        "$dagpenger.refusjonskrav.enkeltkrav[x].bruker.person.pin[x].sektor"
                      ]
                    },
                    "Institution": {
                      "institutionID": "$dagpenger.refusjonskrav.enkeltkrav[x].bruker.person.pin[x].institusjonsid",
                      "institutionName": "$dagpenger.refusjonskrav.enkeltkrav[x].bruker.person.pin[x].institusjonsnavn"
                    }
                  }
                ]
              },
              "IfPINNotProvidedForEveryInstitutionPleaseProvide": {
                "PlaceBirth": {
                  "town": "$dagpenger.refusjonskrav.enkeltkrav[x].bruker.person.foedested.by",
                  "region": "$dagpenger.refusjonskrav.enkeltkrav[x].bruker.person.foedested.region",
                  "country": {
                    "value": [
                      "$dagpenger.refusjonskrav.enkeltkrav[x].bruker.person.foedested.land"
                    ]
                  }
                },
                "fatherFamilyNameAtBirth": "$dagpenger.refusjonskrav.enkeltkrav[x].bruker.far.person.etternavnvedfoedsel",
                "forenameFather": "$dagpenger.refusjonskrav.enkeltkrav[x].bruker.far.person.fornavn",
                "motherFamilyNameAtBirth": "$dagpenger.refusjonskrav.enkeltkrav[x].bruker.mor.person.etternavnvedfoedsel",
                "forenameMother": "$dagpenger.refusjonskrav.enkeltkrav[x].bruker.mor.person.fornavn"
              }
            },
            "AdditionalInformationPerson": {
              "nationality": {
                "value": [
                  "$dagpenger.refusjonskrav.enkeltkrav[x].bruker.person.statsborgerskap[x].land"
                ]
              }
            }
          },
          "reimbursementRequestID": "$dagpenger.refusjonskrav.enkeltkrav[x].refusjonskravid",
          "sequentialNumberIndividualClaim": "$dagpenger.refusjonskrav.enkeltkrav[x].loepenummer",
          "InstitutionWhichCertifiedInsuranceRecord": {
            "institutionID": "$dagpenger.refusjonskrav.enkeltkrav[x].attestererhistorikk.institusjon.id",
            "institutionName": "$dagpenger.refusjonskrav.enkeltkrav[x].attestererhistorikk.institusjon.navn"
          },
          "WorkingPeriodsConsidered": {
            "WorkingPeriodConsidered": [
              {
                "startDate": "$dagpenger.refusjonskrav.enkeltkrav[x].arbeidsperiode[x].startdato",
                "endDate": "$dagpenger.refusjonskrav.enkeltkrav[x].arbeidsperiode[x].sluttdato"
              }
            ]
          },
          "ReimbursementPeriod": {
            "startDate": "$dagpenger.refusjonskrav.enkeltkrav[x].refusjonsperiode.startdato",
            "endDate": "$dagpenger.refusjonskrav.enkeltkrav[x].refusjonsperiode.sluttdato"
          },
          "lastPaymentDate": "$dagpenger.refusjonskrav.enkeltkrav[x].sisteutbetalingsdato",
          "RequestedAmountForReimbursement": {
            "amount": "$dagpenger.refusjonskrav.enkeltkrav[x].anmodnetrefusjonsbeloep.beloep",
            "currency": {
              "value": [
                "$dagpenger.refusjonskrav.enkeltkrav[x].anmodnetrefusjonsbeloep.valuta"
              ]
            }
          }
        }
      ]
    }
  }
}
