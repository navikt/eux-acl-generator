{
  "H131": {
    "sedGVer": "$sedGVer",
    "sedVer": "$sedVer",
    "Person": {
      "PersonIdentification": {
        "familyName": "$nav.bruker.person.etternavn",
        "forename": "$nav.bruker.person.fornavn",
        "dateBirth": "$nav.bruker.person.foedselsdato",
        "sex": {
          "value": [
            "$nav.bruker.person.kjoenn"
          ]
        },
        "familyNameAtBirth": "$nav.bruker.person.etternavnvedfoedsel",
        "forenameAtBirth": "$nav.bruker.person.fornavnvedfoedsel",
        "PINPersonInEachInstitution": {
          "PersonalIdentificationNumber": [
            {
              "country": {
                "value": [
                  "$nav.bruker.person.pin[x].land"
                ]
              },
              "personalIdentificationNumber": "$nav.bruker.person.pin[x].identifikator",
              "sector": {
                "value": [
                  "$nav.bruker.person.pin[x].sektor"
                ]
              },
              "Institution": {
                "institutionID": "$nav.bruker.person.pin[x].institusjonsid",
                "institutionName": "$nav.bruker.person.pin[x].institusjonsnavn"
              }
            }
          ]
        },
        "IfPINNotProvidedForEveryInstitutionPleaseProvide": {
          "PlaceBirth": {
            "town": "$nav.bruker.person.foedested.by",
            "region": "$nav.bruker.person.foedested.region",
            "country": {
              "value": [
                "$nav.bruker.person.foedested.land"
              ]
            }
          },
          "fatherFamilyNameAtBirth": "$nav.bruker.far.person.etternavnvedfoedsel",
          "forenameFather": "$nav.bruker.far.person.fornavn",
          "motherFamilyNameAtBirth": "$nav.bruker.mor.person.etternavnvedfoedsel",
          "forenameMother": "$nav.bruker.mor.person.fornavn"
        }
      },
      "AdditionalInformationPerson": {
        "nationality": {
          "value": [
            "$nav.bruker.person.statsborgerskap[x].land"
          ]
        }
      }
    },
    "AddressesInsuredPerson": {
      "AddressInsuredPerson": [
        {
          "typeAddress": {
            "value": [
              "$nav.bruker.adresse[x].type"
            ]
          },
          "Address": {
            "street": "$nav.bruker.adresse[x].gate",
            "buildingName": "$nav.bruker.adresse[x].bygning",
            "town": "$nav.bruker.adresse[x].by",
            "postalCode": "$nav.bruker.adresse[x].postnummer",
            "region": "$nav.bruker.adresse[x].region",
            "country": {
              "value": [
                "$nav.bruker.adresse[x].land"
              ]
            }
          }
        }
      ]
    },
    "PleaseFillInFollowingSectionIfConcernsSickness": {
      "personStatus": {
        "value": [
          "$horisontal.estimatkontroll.arbeidsulykkeyrkessykdom.sykdom.bruker.status.id"
        ]
      }
    },
    "FillInSectionOnlyIfRequestConcerns": {
      "thisSEDRelatedTo": {
        "value": [
          "$horisontal.estimatkontroll.arbeidsulykkeyrkessykdom.type"
        ]
      },
      "dated": "$horisontal.estimatkontroll.arbeidsulykkeyrkessykdom.dato",
      "accidentDiseaseCode": "$horisontal.estimatkontroll.arbeidsulykkeyrkessykdom.sykdom.kode",
      "accidentDiseaseCodingSystem": "$horisontal.estimatkontroll.arbeidsulykkeyrkessykdom.sykdom.kodingssystem",
      "consequencesAccidentKindOrShortDescriptionDisease": "$horisontal.estimatkontroll.arbeidsulykkeyrkessykdom.konsekvensellerbeskrivelse",
      "statusPerson": {
        "value": [
          "$horisontal.estimatkontroll.arbeidsulykkeyrkessykdom.aktivitet.status.id"
        ]
      },
      "PleaseFillInFollowingIfStatusPersonOther": {
        "other": "$horisontal.estimatkontroll.arbeidsulykkeyrkessykdom.aktivitet.status.annet"
      },
      "Employer": {
        "name": "$horisontal.estimatkontroll.arbeidsulykkeyrkessykdom.arbeidsgiver.navn",
        "IdentificationNumbers": {
          "IdentificationNumber": [
            {
              "number": "$horisontal.estimatkontroll.arbeidsulykkeyrkessykdom.arbeidsgiver.identifikator[x].id",
              "type": {
                "value": [
                  "$horisontal.estimatkontroll.arbeidsulykkeyrkessykdom.arbeidsgiver.identifikator[x].type"
                ]
              }
            }
          ]
        },
        "Address": {
          "street": "$horisontal.estimatkontroll.arbeidsulykkeyrkessykdom.arbeidsgiver.adresse.gate",
          "buildingName": "$horisontal.estimatkontroll.arbeidsulykkeyrkessykdom.arbeidsgiver.adresse.bygning",
          "town": "$horisontal.estimatkontroll.arbeidsulykkeyrkessykdom.arbeidsgiver.adresse.by",
          "postalCode": "$horisontal.estimatkontroll.arbeidsulykkeyrkessykdom.arbeidsgiver.adresse.postnummer",
          "region": "$horisontal.estimatkontroll.arbeidsulykkeyrkessykdom.arbeidsgiver.adresse.region",
          "country": {
            "value": [
              "$horisontal.estimatkontroll.arbeidsulykkeyrkessykdom.arbeidsgiver.adresse.land"
            ]
          }
        }
      }
    },
    "InReplyRequest": {
      "ForEstimatedCostsAdministrativeCheck": {
        "WeInformEstimatedCostsAre": {
          "amount": "$horisontal.estimatkontroll.svar.undersoekelse.estimat.kostnader.beloep",
          "currency": {
            "value": [
              "$horisontal.estimatkontroll.svar.undersoekelse.estimat.kostnader.valuta"
            ]
          }
        }
      },
      "ToCarryOutAnAdministrativeCheck": {
        "theAdministrativeCheck": {
          "value": [
            "$horisontal.estimatkontroll.svar.administrativkontroll.erutfoert.type"
          ]
        },
        "reasonForNotCarryingOutAdministrativeCheck": {
          "value": [
            "$horisontal.estimatkontroll.svar.administrativkontroll.ikkeutfoert.grunn.type"
          ]
        },
        "FillInIfReasonForNotCarryingOut": {
          "otherReason": "$horisontal.estimatkontroll.svar.administrativkontroll.ikkeutfoert.grunn.annen"
        }
      }
    },
    "AdditionalInformation": {
      "additionalInformation": "$nav.ytterligereinformasjon"
    }
  }
}