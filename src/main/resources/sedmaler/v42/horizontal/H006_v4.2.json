{
  "H006": {
    "sedGVer": "$sedGVer",
    "sedVer": "$sedVer",
    "sedPackage": "Sector Components/Horizontal/H006",
    "Person": {
      "PersonIdentification": {
        "familyName": "$nav.bruker.person.etternavn",
        "forename": "$nav.bruker.person.fornavn",
        "dateBirth": "$nav.bruker.person.foedselsdato",
        "sex": {
          "value": [
            "$nav.bruker.person.kjoenn"
          ]
        },
        "familyNameAtBirth": "$nav.bruker.person.etternavnvedfoedsel",
        "forenameAtBirth": "$nav.bruker.person.fornavnvedfoedsel",
        "PINPersonInEachInstitution": {
          "PersonalIdentificationNumber": [
            {
              "country": {
                "value": [
                  "$nav.bruker.person.pin[x].land"
                ]
              },
              "personalIdentificationNumber": "$nav.bruker.person.pin[x].identifikator",
              "sector": {
                "value": [
                  "$nav.bruker.person.pin[x].sektor"
                ]
              },
              "Institution": {
                "institutionID": "$nav.bruker.person.pin[x].institusjonsid",
                "institutionName": "$nav.bruker.person.pin[x].institusjonsnavn"
              }
            }
          ]
        },
        "IfPINNotProvidedForEveryInstitutionPleaseProvide": {
          "PlaceBirth": {
            "town": "$nav.bruker.person.foedested.by",
            "region": "$nav.bruker.person.foedested.region",
            "country": {
              "value": [
                "$nav.bruker.person.foedested.land"
              ]
            }
          },
          "fatherFamilyNameAtBirth": "$nav.bruker.far.person.etternavnvedfoedsel",
          "forenameFather": "$nav.bruker.far.person.fornavn",
          "motherFamilyNameAtBirth": "$nav.bruker.mor.person.etternavnvedfoedsel",
          "forenameMother": "$nav.bruker.mor.person.fornavn"
        }
      },
      "AdditionalInformationPerson": {
        "nationality": {
          "value": [
            "$nav.bruker.person.statsborgerskap[x].land"
          ]
        }
      }
    },
    "PositiveReplyRequestedInformation": {
      "WeProvideFollowingInformationElementsResidence": {
        "Address": {
          "AddressPerson": [
            {
              "typeAddress": {
                "value": [
                  "$horisontal.informasjonombosted.bruker.adresse[x].type"
                ]
              },
              "Address": {
                "street": "$horisontal.informasjonombosted.bruker.adresse[x].gate",
                "buildingName": "$horisontal.informasjonombosted.bruker.adresse[x].bygning",
                "town": "$horisontal.informasjonombosted.bruker.adresse[x].by",
                "postalCode": "$horisontal.informasjonombosted.bruker.adresse[x].postnummer",
                "region": "$horisontal.informasjonombosted.bruker.adresse[x].region",
                "country": {
                  "value": [
                    "$horisontal.informasjonombosted.bruker.adresse[x].land"
                  ]
                }
              }
            }
          ]
        },
        "StatusPerson": {
          "statusPerson": {
            "value": [
              "$horisontal.svar.aktivitet.status.id"
            ]
          },
          "PleaseFillInIfStatusPersonOther": {
            "other": "$horisontal.svar.aktivitet.status.annet"
          }
        },
        "DescriptionNatureSpecificCharacteristicsActivity": [
          {
            "typeActivity": {
              "value": [
                "$horisontal.svar.aktivitet.type"
              ]
            },
            "descriptionActivity": "$horisontal.svar.aktivitet.beskrivelse",
            "locationActivity": "$horisontal.svar.aktivitet.sted",
            "durationActivity": "$horisontal.svar.aktivitet.varighet",
            "natureActivity": "$horisontal.svar.aktivitet.art"
          }
        ],
        "sourceIncomeStudents": "$horisontal.svar.inntektskilde.studenter",
        "housingSituationInParticularHowPermanentItIs": "$horisontal.svar.fastslaabosted.bruker.hvorpermanent",
        "residenceForTaxPurposes": "$horisontal.svar.fastslaabosted.bruker.permanentoppholdskattemessig",
        "FamilyStatus": {
          "familyMemberSpouse": "$horisontal.svar.familiestatus.ektefelle.familiemedlem",
          "placeResidenceSpouse": "$horisontal.svar.familiestatus.ektefelle.bosted",
          "familyMemberChildren": "$horisontal.svar.familiestatus.barn.familiemedlem",
          "placeResidenceChildren": "$horisontal.svar.familiestatus.barn.bosted",
          "placeSchoolChildren": "$horisontal.svar.familiestatus.barn.skolekrets"
        },
        "intentionPersonConcernedReasonsMove": "$horisontal.svar.fastslaabosted.bruker.grunnforflytting"
      }
    },
    "NegativeReplyRequestedInformation": {
      "weAreUnableForwardRequestedInformationInPoints": "$horisontal.negativtsvar.kunneikkevideresendeinformasjon",
      "reasons": "$horisontal.negativtsvar.grunner"
    },
    "AdditionalInformation": {
      "additionalInformation": "$nav.ytterligereinformasjon"
    }
  }
}