{
  "P8000" : {
    "RequestForInformation" : {
      "InformationPersonBenefit" : [ {
        "PleaseFillInFollowingIfPleaseInformIfPersonIs" : {
          "otherBenefit" : "$pensjon.anmodning.informasjon.infoOmPersonYtelse[x].annenYtelse"
        },
        "PleaseSendInformationOn" : [ {
          "pleaseSendInformationOn" : {
            "value" : [ "$pensjon.anmodning.informasjon.infoOmPersonYtelse[x].sendInfoOm[x].sendInfoOm" ]
          },
          "FillInIfPleaseSendInformationOn" : {
            "otherInformationBenefit" : "$pensjon.anmodning.informasjon.infoOmPersonYtelse[x].sendInfoOm[x].annenInfoOmYtelser"
          }
        } ],
        "pleaseInformIfPersonIsWasClaimingIsWasReceiving" : {
          "value" : [ "$pensjon.anmodning.informasjon.infoOmPersonYtelse[x].informerOmPersonHarFremsattKravEllerMottattYtelse" ]
        }
      } ],
      "PersonIncome" : [ {
        "pleaseInformAboutPersonIncome" : {
          "value" : [ "$pensjon.anmodning.personInntekt[x].inntekt" ]
        },
        "pleaseStateIncomeEffectiveSince" : "$pensjon.anmodning.personInntekt[x].oppgiInntektFOM"
      } ],
      "generalInformation" : {
        "value" : [ "$pensjon.anmodning.informasjon.generellPersonInfo" ]
      },
      "InformationPersonActivity" : {
        "pleaseInformAboutPersonActivityAs" : {
          "value" : [ "$pensjon.anmodning.personAktivitetSom[x].persAktivitetSom" ]
        },
        "pleaseInform" : {
          "value" : [ "$pensjon.anmodning.personAktivitet[x].persAktivitet" ]
        }
      },
      "reasonForRequest" : "$pensjon.anmodning.informasjon.begrunnelseKrav",
      "otherRequestedInformation" : "$pensjon.anmodning.informasjon.annenEtterspurtInformasjon"
    },
    "InsuredPerson" : {
      "PersonIdentification" : {
        "IfPINNotProvidedForEveryInstitutionPleaseProvide" : {
          "PlaceBirth" : {
            "town" : "$nav.bruker.person.foedested.by",
            "country" : {
              "value" : [ "$nav.bruker.person.foedested.land" ]
            },
            "region" : "$nav.bruker.person.foedested.region"
          },
          "fatherFamilyNameAtBirth" : "$nav.ektefelle.far.person.etternavnvedfoedsel",
          "forenameMother" : "$nav.ektefelle.mor.person.fornavn",
          "forenameFather" : "$nav.ektefelle.far.person.fornavn",
          "motherFamilyNameAtBirth" : "$nav.ektefelle.mor.person.etternavnvedfoedsel"
        },
        "forename" : "$nav.bruker.person.fornavn",
        "familyName" : "$nav.bruker.person.etternavn",
        "forenameAtBirth" : "$nav.bruker.person.fornavnvedfoedsel",
        "sex" : {
          "value" : [ "$nav.bruker.person.kjoenn" ]
        },
        "PINPersonInEachInstitution" : {
          "PersonalIdentificationNumber" : [ {
            "Institution" : {
              "institutionID" : "$nav.bruker.person.pin[x].institusjon.institusjonsid",
              "institutionName" : "$nav.bruker.person.pin[x].institusjon.institusjonsnavn"
            },
            "sector" : {
              "value" : [ "$nav.bruker.person.pin[x].institusjon.sektor" ]
            },
            "personalIdentificationNumber" : "$nav.bruker.person.pin[x].identifikator",
            "country" : {
              "value" : [ "$nav.bruker.person.pin[x].land" ]
            }
          } ]
        },
        "dateBirth" : "$nav.bruker.person.foedselsdato",
        "familyNameAtBirth" : "$nav.bruker.person.etternavnvedfoedsel"
      },
      "AdditionalInformationPerson" : {
        "AdditionalInformationPerson" : {
          "nationality" : {
            "value" : [ "$nav.bruker.person.statsborgerskap[x].land" ]
          },
          "previousForename" : "$nav.bruker.person.tidligerefornavn",
          "previousFamilyName" : "$nav.bruker.person.tidligereetternavn"
        },
        "ContactInformationPerson" : {
          "TelephoneNumbers" : {
            "TelephoneNumber" : [ {
              "number" : "$nav.bruker.person.kontakt.telefon[x].nummer",
              "type" : {
                "value" : [ "$nav.bruker.person.kontakt.telefon[x].type" ]
              }
            } ]
          },
          "EmailAddresses" : {
            "EmailAddress" : [ {
              "email" : "$nav.bruker.person.kontakt.email[x].adresse"
            } ]
          }
        },
        "Address" : {
          "country" : {
            "value" : [ "$nav.bruker.adresse.land" ]
          },
          "street" : "$nav.bruker.adresse.gate",
          "region" : "$nav.bruker.adresse.region",
          "town" : "$nav.bruker.adresse.by",
          "postalCode" : "$nav.bruker.adresse.postnummer",
          "buildingName" : "$nav.bruker.adresse.bygning"
        }
      }
    },
    "RequestForPersonStatement" : {
      "reasonForRequest" : "$pensjon.anmodning.anmodningPerson.begrunnelseKrav",
      "pleaseProvideFollowingStatementPerson" : "$pensjon.anmodning.anmodningPerson.egenerklaering"
    },
    "OtherPerson" : {
      "PersonIdentification" : {
        "familyNameAtBirth" : "$nav.annenperson.person.etternavnvedfoedsel",
        "IfPINNotProvidedForEveryInstitutionPleaseProvide" : {
          "forenameMother" : "$nav.annenperson.mor.person.fornavnvedfoedsel",
          "PlaceBirth" : {
            "town" : "$nav.annenperson.person.foedested.by",
            "region" : "$nav.annenperson.person.foedested.region",
            "country" : {
              "value" : [ "$nav.annenperson.person.foedested.land" ]
            }
          },
          "forenameFather" : "$nav.annenperson.far.person.fornavnvedfoedsel",
          "fatherFamilyNameAtBirth" : "$nav.annenperson.far.person.etternavnvedfoedsel",
          "motherFamilyNameAtBirth" : "$nav.annenperson.mor.person.etternavnvedfoedsel"
        },
        "PINPersonInEachInstitution" : {
          "PersonalIdentificationNumber" : [ {
            "Institution" : {
              "institutionName" : "$nav.annenperson.person.pin[x].institusjonsnavn",
              "institutionID" : "$nav.annenperson.person.pin[x].institusjonsid"
            },
            "sector" : {
              "value" : [ "$nav.annenperson.person.pin[x].sektor" ]
            },
            "country" : {
              "value" : [ "$nav.annenperson.person.pin[x].land" ]
            },
            "personalIdentificationNumber" : "$nav.annenperson.person.pin[x].identifikator"
          } ]
        },
        "sex" : {
          "value" : [ "$nav.annenperson.person.kjoenn" ]
        },
        "forenameAtBirth" : "$nav.annenperson.person.fornavnvedfoedsel",
        "familyName" : "$nav.annenperson.person.etternavn",
        "dateBirth" : "$nav.annenperson.person.foedselsdato",
        "forename" : "$nav.annenperson.person.fornavn"
      },
      "AdditionalInformationPerson" : {
        "Address" : {
          "postalCode" : "$nav.annenperson.adresse.postnummer",
          "country" : {
            "value" : [ "$nav.annenperson.adresse.land" ]
          },
          "region" : "$nav.annenperson.adresse.region",
          "town" : "$nav.annenperson.adresse.by",
          "buildingName" : "$nav.annenperson.adresse.bygning",
          "street" : "$nav.annenperson.adresse.gate"
        },
        "AdditionalInformationPerson" : {
          "previousForename" : "$nav.annenperson.person.tidligerefornavn",
          "nationality" : {
            "value" : [ "$nav.annenperson.person.statsborgerskap[x].land" ]
          },
          "previousFamilyName" : "$nav.annenperson.person.tidligereetternavn"
        },
        "ContactInformationPerson" : {
          "TelephoneNumbers" : {
            "TelephoneNumber" : [ {
              "number" : "$nav.annenperson.person.kontakt.telefon[x].nummer",
              "type" : {
                "value" : [ "$nav.annenperson.person.kontakt.telefon[x].type" ]
              }
            } ]
          },
          "EmailAddresses" : {
            "EmailAddress" : [ {
              "email" : "$nav.annenperson.person.kontakt.email[x].adresse"
            } ]
          }
        }
      },
      "rolePerson" : {
        "value" : [ "$nav.annenperson.person.rolle" ]
      }
    },
    "RequestForDocument" : {
      "FillInIfPleaseProvideWithFollowing" : {
        "additionalInformationDocument" : "$pensjon.anmodning.ytterligereInfoOmDokumenter"
      },
      "reasonForRequest" : "$pensjon.anmodning.begrunnKrav",
      "pleaseProvideWithFollowingDocuments" : {
        "value" : [ "$pensjon.vedlegg[x]" ]
      }
    },
    "RelationshipDependantFamilyMemberOrChildInsured" : {
      "FillInIfRelationshipInsuredPerson" : {
        "descriptionOtherRelative" : "$pensjon.anmodning.beskrivelseAnnenSlektning"
      },
      "RelationshipInsuredPerson" : {
        "relationshipInsuredPerson" : {
          "value" : [ "$pensjon.anmodning.relasjonTilForsikretPerson" ]
        }
      }
    },
    "LocalCaseNumbers" : {
      "LocalCaseNumber" : [ {
        "country" : {
          "value" : [ "$nav.eessisak[x].land" ]
        },
        "Institution" : {
          "institutionName" : "$nav.eessisak[x].institusjonsnavn",
          "institutionID" : "$nav.eessisak[x].institusjonsid"
        },
        "caseNumber" : "$nav.eessisak[x].saksnummer"
      } ]
    },
    "RequestForSED" : {
      "RequestForSED" : [ {
        "FillInIfPleaseProvideWithFollowing" : {
          "otherRequestedSED" : "$pensjon.anmodning.seder[x].andreEtterspurteSEDer",
          "reasonForRequest" : "$pensjon.anmodning.seder[x].begrunnelse"
        },
        "pleaseProvideWithFollowingSEDs" : {
          "value" : [ "$pensjon.anmodning.seder[x].sendFolgendeSEDer[x]" ]
        }
      } ]
    },
    "AdditionalInformation" : {
      "additionalInformation" : "$pensjon.ytterligeinformasjon"
    },
    "RequestForConfirmationInformation" : {
      "reasonForRequest" : "$pensjon.anmodning.anmodningOmBekreftelse.bekreftelsesGrunn",
      "pleaseConfirmFollowingInformation" : "$pensjon.anmodning.anmodningOmBekreftelse.bekreftelseInfo"
    },
    "ReferencePerson" : {
      "thisRequestMadeWithReferencePersonNamedIn" : {
        "value" : [ "$pensjon.anmodning.referanseTilPerson" ]
      }
    }
  }
}