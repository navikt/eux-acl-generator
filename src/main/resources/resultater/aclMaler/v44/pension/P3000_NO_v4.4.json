          ]
        },
        "PleaseFillInFollowingIfAboveAnsweredNo": {
          "reason": "$pensjon.landspesifikk.norge.ufore.grunn"
        }
      }
    },
    "sedGVer": "$sedGVer",
    "sedVer": "$sedVer"
  }
