            "town": "$pensjon.landspesifikk.norge.ufore.barnInfo[x].adresse.by",
            "postalCode": "$pensjon.landspesifikk.norge.ufore.barnInfo[x].adresse.postnummer",
            "region": "$pensjon.landspesifikk.norge.ufore.barnInfo[x].adresse.region",
            "country": {
              "value": [
                "$pensjon.landspesifikk.norge.ufore.barnInfo[x].adresse.land"
              ]
            }
          },
          "DoesChildLiveTogetherWithBothParents": {
            "FillInFollowingIfDoesChildLiveTogether": {
              "doesChildLiveTogetherWithBothParentsIndicator": {
                "value": [
                  "$pensjon.landspesifikk.norge.ufore.barnInfo[x].borMedBeggeForeldre"
                ]
              },
              "doesInsuredPersonSupportChildIndicator": {
                "value": [
                  "$pensjon.landspesifikk.norge.ufore.barnInfo[x].forsikredeForsorgerBarnet"
                ]
              },
              "doesChildLiveWithInsuredPersonIndicator": {
                "value": [
                  "$pensjon.landspesifikk.norge.ufore.barnInfo[x].barnetBorHosForsikrede"
                ]
              }
            }
          }
        }
      ],
      "UnableProvideRequestedInformationInThisSection": {
        "isRequestedInformationAvailableIndicator": {
          "value": [
