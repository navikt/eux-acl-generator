            "amount" : "$familie.ytelse.barn[x].beloep"
          },
          "DateForGrantedBenefits" : {
            "startDate" : "$familie.ytelse.barn[x].startdato",
            "endDate" : "$familie.ytelse.barn[x].sluttdato"
          },
          "nameBeneficiary" : "$familie.ytelse.barn[x].mottaker.navn",
          "periodDefinition" : "$familie.ytelse.barn[x].avgrensningperiode"
        },
        "nameBenefit" : "$familie.ytelse.barn[x].betegnelseytelse",
        "nameChild" : "$familie.ytelse.barn[x].barnetsnavn"
      } ]
    },
    "AmountsFamilyBenefitForEntireFamily" : {
      "AmountFamilyBenefit" : [ {
        "FamilyBenefitDetails" : {
          "periodDefinition" : "$familie.ytelse.helefamilie[x].avgrensningperiode",
          "DateForGrantedBenefits" : {
            "startDate" : "$familie.ytelse.helefamilie[x].startdato",
            "endDate" : "$familie.ytelse.helefamilie[x].sluttdato"
          },
          "Amount" : {
            "currency" : {
              "value" : [ "$familie.ytelse.helefamilie[x].valuta" ]
            },
            "amount" : "$familie.ytelse.helefamilie[x].beloep"
          },
          "nameBeneficiary" : "$familie.ytelse.helefamilie[x].mottaker.navn"
        },
        "numberPersonsBenefitsAreGrantedFor" : "$familie.ytelse.helefamilie[x].antallpersoner",
        "nameBenefit" : "$familie.ytelse.helefamilie[x].betegnelseytelse"
      } ]
    },
    "Decision" : {
      "DecisionNotConcernAllChildrenMentioned" : {
        "ChildForWhomThisDecisionApplies" : [ {
          "forename" : "$familie.vedtak.gjelder.barn[x].person.fornavn",
          "dateBirth" : "$familie.vedtak.gjelder.barn[x].person.foedselsdato",
          "familyName" : "$familie.vedtak.gjelder.barn[x].person.etternavn"
        } ],
        "DecisionRegardingAllChildrenMentionedInThisSED" : {
          "value" : [ "$familie.vedtak.gjelderallebarnnei" ]
        }
      },
      "Periods" : {
        "Period" : [ {
          "OpenPeriod" : {
            "startDate" : "$familie.vedtak.periode[x].aapenperiode.startdato",
            "typeOpenPeriod" : {
              "value" : [ "$familie.vedtak.periode[x].aapenperiode.type" ]
            }
          },
          "FixedPeriod" : {
            "endDate" : "$familie.vedtak.periode[x].fastperiode.sluttdato",
            "startDate" : "$familie.vedtak.periode[x].fastperiode.startdato"
          }
        } ]
      },
      "theReasonForDecision" : "$familie.vedtak.grunn",
      "additionalInformation" : "$familie.vedtak.ytterligereinformasjon",
      "DecisionRegardingAllChildrenMentionedInThisSED" : {
        "value" : [ "$familie.vedtak.gjelderallebarnja" ]
      },
      "decisionCompetenceRegardingPriorityRight" : "$familie.vedtak.kompetanse.prioritet"
    },
    "ReceiptApplicationForFamilyBenefits" : {
      "dateReceiptApplication" : "$familie.krav.dato",
      "typeClaim" : {
        "value" : [ "$familie.krav.type" ]
      }
    }
  }
}