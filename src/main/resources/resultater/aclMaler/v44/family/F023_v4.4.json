{
  "F023" : {
    "PeriodsAtLastRegisteredInstitution" : {
      "InsuranceResidencePeriods" : {
        "InsuranceResidencePeriod" : [ {
          "typePeriod" : {
            "value" : [ "$bruker.registrertsist.institusjon.periode[x].type43" ]
          },
          "Period" : {
            "OpenPeriod" : {
              "typeOpenPeriod" : {
                "value" : [ "$bruker.registrertsist.institusjon.periode[x].aapenperiode.type" ]
              },
              "startDate" : "$bruker.registrertsist.institusjon.periode[x].aapenperiode.startdato"
            },
            "FixedPeriod" : {
              "endDate" : "$bruker.registrertsist.institusjon.periode[x].fastperiode.sluttdato",
              "startDate" : "$bruker.registrertsist.institusjon.periode[x].fastperiode.startdato"
            }
          }
        } ]
      },
      "Institution" : {
        "institutionName" : "$bruker.registrertsist.institusjon.navn",
        "institutionID" : "$bruker.registrertsist.institusjon.id"
      }
    },
    "PeriodsAtCurrentRegisteredInstitution" : {
      "Institution" : {
        "institutionID" : "$bruker.registrertnaa.institusjon.id",
        "institutionName" : "$bruker.registrertnaa.institusjon.navn"
      },
      "InsuranceResidencePeriods" : {
        "InsuranceResidencePeriod" : [ {
          "typePeriod" : {
            "value" : [ "$bruker.registrertnaa.institusjon.periode[x].type43" ]
          },
          "Period" : {
            "FixedPeriod" : {
              "endDate" : "$bruker.registrertnaa.institusjon.periode[x].fastperiode.sluttdato",
              "startDate" : "$bruker.registrertnaa.institusjon.periode[x].fastperiode.startdato"
            },
            "OpenPeriod" : {
              "typeOpenPeriod" : {
                "value" : [ "$bruker.registrertnaa.institusjon.periode[x].aapenperiode.type" ]
              },
              "startDate" : "$bruker.registrertnaa.institusjon.periode[x].aapenperiode.startdato"
            }
          }
        } ]
      }
    },
    "Person" : {
      "ContactDetails" : {
        "TelephoneNumbers" : {
          "TelephoneNumber" : [ {
            "number" : "$bruker.personinfo.telefoner[x].nummer",
            "type" : {
              "value" : [ "$bruker.personinfo.telefoner[x].type" ]
            }
          } ]
        },
        "EmailAddresses" : {
          "EmailAddress" : [ {
            "email" : "$bruker.personinfo.epostadresser[x]"
          } ]
        }
      },
      "AddressesPerson" : {
        "AddressPerson" : [ {
          "typeAddress" : {
            "value" : [ "$bruker.personinfo.adresser[x].type" ]
          },
          "Address" : {
            "town" : "$bruker.personinfo.adresser[x].by",
            "street" : "$bruker.personinfo.adresser[x].gate",
            "buildingName" : "$bruker.personinfo.adresser[x].bygning",
            "region" : "$bruker.personinfo.adresser[x].region",
            "postalCode" : "$bruker.personinfo.adresser[x].postnummer",
            "country" : {
              "value" : [ "$bruker.personinfo.adresser[x].land" ]
            }
          }
        } ]
      },
      "CoverageBySocialSecurityScheme" : {
        "PeriodsEntitlement" : {
          "PeriodOfEntitlement" : [ {
            "EntitlementFamilyBenefitsExists" : {
              "PeriodEntitlementFamilyBenefits" : {
                "PeriodEntitlementFamilyBenefit" : [ {
                  "OpenPeriod" : {
                    "startDate" : "$bruker.periodermedretttilytelser[x].retttilfamilieytelser[x].periode.aapenperiode.startdato",
                    "typeOpenPeriod" : {
                      "value" : [ "$bruker.periodermedretttilytelser[x].retttilfamilieytelser[x].periode.aapenperiode.type" ]
                    }
                  },
                  "FixedPeriod" : {
                    "endDate" : "$bruker.periodermedretttilytelser[x].retttilfamilieytelser[x].periode.fastperiode.sluttdato",
                    "startDate" : "$bruker.periodermedretttilytelser[x].retttilfamilieytelser[x].periode.fastperiode.startdato"
                  }
                } ]
              }
            },
            "EntitlementFamilyBenefitsDoesNotExist" : {
              "PeriodNoEntitlementFamilyBenefits" : {
                "PeriodNoEntitlementToFamilyBenefit" : [ {
                  "Period" : {
                    "FixedPeriod" : {
                      "endDate" : "$bruker.periodermedretttilytelser[x].ikkeretttilfamilieytelser[x].periode.fastperiode.sluttdato",
                      "startDate" : "$bruker.periodermedretttilytelser[x].ikkeretttilfamilieytelser[x].periode.fastperiode.startdato"
                    },
                    "OpenPeriod" : {
                      "typeOpenPeriod" : {
                        "value" : [ "$bruker.periodermedretttilytelser[x].ikkeretttilfamilieytelser[x].periode.aapenperiode.type" ]
                      },
                      "startDate" : "$bruker.periodermedretttilytelser[x].ikkeretttilfamilieytelser[x].periode.aapenperiode.startdato"
                    }
                  },
                  "otherReason" : "$bruker.periodermedretttilytelser[x].ikkeretttilfamilieytelser[x].grunn.annen",
                  "reason" : {
                    "value" : [ "$bruker.periodermedretttilytelser[x].ikkeretttilfamilieytelser[x].grunn.FReasonEntitlementType" ]
                  }
                } ]
              }
            }
          } ]
        },
        "PeriodsCoveredBySecuritySchemeInSendingMember" : {
          "Period" : [ {
            "endDate" : "$bruker.perioderdekketavtrygdeordning.periode[x].sluttdato",
            "startDate" : "$bruker.perioderdekketavtrygdeordning.periode[x].startdato"
          } ]
        },
        "PeriodsNotCovered" : {
          "PeriodNotCovered" : [ {
            "endDate" : "$bruker.perioderikkedekketavtrygdeordning.periode[x].sluttdato",
            "startDate" : "$bruker.perioderikkedekketavtrygdeordning.periode[x].startdato"
          } ]
        }
      },
      "PersonIdentification" : {
        "PINPersonInEachInstitution" : {
          "PersonalIdentificationNumber" : [ {
            "sector" : {
              "value" : [ "$bruker.personinfo.pin[x].sektor" ]
            },
            "Institution" : {
              "institutionID" : "$bruker.personinfo.pin[x].institusjonsid",
              "institutionName" : "$bruker.personinfo.pin[x].institusjonsnavn"
            },
            "personalIdentificationNumber" : "$bruker.personinfo.pin[x].identifikator",
            "country" : {
              "value" : [ "$bruker.personinfo.pin[x].land" ]
            }
          } ]
        },
        "IfPINNotProvidedForEveryInstitutionPleaseProvide" : {
          "forenameMother" : "$bruker.personinfo.pinmangler.mor.fornavn",
          "forenameFather" : "$bruker.personinfo.pinmangler.far.fornavn",
          "motherFamilyNameAtBirth" : "$bruker.personinfo.pinmangler.mor.etternavnvedfoedsel",
          "PlaceBirth" : {
            "town" : "$bruker.personinfo.pinmangler.foedested.by",
            "region" : "$bruker.personinfo.pinmangler.foedested.region",
            "country" : {
              "value" : [ "$bruker.personinfo.pinmangler.foedested.land" ]
            }
          },
          "fatherFamilyNameAtBirth" : "$bruker.personinfo.pinmangler.far.etternavnvedfoedsel"
        },
        "sex" : {
          "value" : [ "$bruker.personinfo.kjoenn" ]
        },
        "familyName" : "$bruker.personinfo.etternavn",
        "forenameAtBirth" : "$bruker.personinfo.pinmangler.fornavnvedfoedsel",
        "dateBirth" : "$bruker.personinfo.foedselsdato",
        "forename" : "$bruker.personinfo.fornavn",
        "familyNameAtBirth" : "$bruker.personinfo.pinmangler.etternavnvedfoedsel"
      },
      "AdditionalInformationAboutNationality" : {
        "Nationalities" : [ {
          "nationality" : {
            "value" : [ "$bruker.personinfo.statsborgerskap[x].land" ]
          },
          "since" : "$bruker.personinfo.statsborgerskap[x].siden"
        } ]
      }
    },
    "PeriodsAtInstitutionInPlaceResidence" : {
      "InsuranceResidencePeriods" : {
        "InsuranceResidencePeriod" : [ {
          "Period" : {
            "FixedPeriod" : {
              "endDate" : "$bruker.bosted.institusjon.periode[x].fastperiode.sluttdato",
              "startDate" : "$bruker.bosted.institusjon.periode[x].fastperiode.startdato"
            },
            "OpenPeriod" : {
              "typeOpenPeriod" : {
                "value" : [ "$bruker.bosted.institusjon.periode[x].aapenperiode.type" ]
              },
              "startDate" : "$bruker.bosted.institusjon.periode[x].aapenperiode.startdato"
            }
          },
          "typePeriod" : {
            "value" : [ "$bruker.bosted.institusjon.periode[x].type43" ]
          }
        } ]
      },
      "Institution" : {
        "institutionID" : "$bruker.bosted.institusjon.id",
        "institutionName" : "$bruker.bosted.institusjon.navn"
      }
    },
    "AdditionalInformation" : {
      "additionalInformation" : "$nav.ytterligereinformasjon"
    }
  }
}