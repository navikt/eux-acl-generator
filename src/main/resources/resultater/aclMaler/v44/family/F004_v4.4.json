        "NonSEPAAccount" : {
          "BankAddress" : {
            "region" : "$familie.fremsettendemyndighet.ikkesepa.bank.adresse.region",
            "town" : "$familie.fremsettendemyndighet.ikkesepa.bank.adresse.by",
            "postalCode" : "$familie.fremsettendemyndighet.ikkesepa.bank.adresse.postnummer",
            "country" : {
              "value" : [ "$familie.fremsettendemyndighet.ikkesepa.bank.adresse.land" ]
            },
            "buildingName" : "$familie.fremsettendemyndighet.ikkesepa.bank.adresse.bygning",
            "street" : "$familie.fremsettendemyndighet.ikkesepa.bank.adresse.gate"
          },
          "BICSWIFT" : "$familie.fremsettendemyndighet.ikkesepa.swift",
          "bankName" : "$familie.fremsettendemyndighet.ikkesepa.bankensnavn",
          "accountNumber" : "$familie.fremsettendemyndighet.ikkesepa.kontonummer"
        }
      },
      "reasonForAuthorityClaim" : "$familie.fremsettendemyndighet.begrunnelse"
    }
  }
}