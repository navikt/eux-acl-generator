          "value" : [ "$familie.vedtak.uenighet.grunn.ansettelse.periodestatus.for" ]
        },
        "durationTerritory" : {
          "value" : [ "$familie.vedtak.uenighet.grunn.oppholdsvarighet.for" ]
        }
      },
      "dateDecision" : "$familie.vedtak.dato",
      "typeDecision" : {
        "value" : [ "$familie.vedtak.type" ]
      }
    }
  }
}