          }
        },
        "WorkingPeriodsConsidered" : {
          "WorkingPeriodConsidered" : [ {
            "startDate" : "$dagpenger.refusjonskrav.enkeltkrav[x].arbeidsperiode[x].startdato",
            "endDate" : "$dagpenger.refusjonskrav.enkeltkrav[x].arbeidsperiode[x].sluttdato"
          } ]
        },
