{
  "U026" : {
    "InformationChargingInterest" : {
      "TotalAmountOutstandingClaims" : {
        "currency" : {
          "value" : [ "$dagpenger.refusjonskrav.beloep.valuta" ]
        },
        "amount" : "$dagpenger.refusjonskrav.beloep.totalbeloep"
      },
      "interestRate" : "$dagpenger.refusjonskrav.rentebetaling.rentesats",
      "dueDate" : "$dagpenger.refusjonskrav.forfallsdato",
      "reimbursementRequestID" : "$dagpenger.refusjonskrav.id"
    },
    "LocalCaseNumbers" : {
      "LocalCaseNumber" : [ {
        "Institution" : {
          "institutionName" : "$nav.eessisak[x].institusjonsnavn",
          "institutionID" : "$nav.eessisak[x].institusjonsid"
        },
        "caseNumber" : "$nav.eessisak[x].saksnummer",
        "country" : {
          "value" : [ "$nav.eessisak[x].land" ]
        }
      } ]
    },
    "IndividualClaimsWhichInterestApplies" : {
      "IndividualClaimWhichInterestApplies" : [ {
        "Person" : {
          "sex" : {
            "value" : [ "$dagpenger.refusjonskrav.enkeltkrav[x].rentebetaling.bruker.person.kjoenn" ]
          },
          "dateBirth" : "$dagpenger.refusjonskrav.enkeltkrav[x].rentebetaling.bruker.person.foedselsdato",
          "familyName" : "$dagpenger.refusjonskrav.enkeltkrav[x].rentebetaling.bruker.person.etternavn",
          "forename" : "$dagpenger.refusjonskrav.enkeltkrav[x].rentebetaling.bruker.person.fornavn"
        },
        "sequentialNumberIndividualClaim" : "$dagpenger.refusjonskrav.enkeltkrav[x].rentebetaling.loepenummer"
      } ]
    }
  }
}