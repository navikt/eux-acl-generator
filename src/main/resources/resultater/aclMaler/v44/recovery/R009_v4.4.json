                } ]
              },
              "familyNameAtBirth" : "$nav.andrepersoner[x].bruker.person.etternavnvedfoedsel",
              "dateBirth" : "$nav.andrepersoner[x].bruker.person.foedselsdato",
              "sex" : {
                "value" : [ "$nav.andrepersoner[x].bruker.person.kjoenn" ]
              },
              "forename" : "$nav.andrepersoner[x].bruker.person.fornavn",
              "familyName" : "$nav.andrepersoner[x].bruker.person.etternavn"
            },
            "AdditionalInformationAboutPerson" : {
              "PreviousForenames" : {
                "PreviousForename" : [ {
                  "previousForename" : "$nav.andrepersoner[x].bruker.person.tidligerefornavn[x].navn"
                } ]
              },
              "PreviousFamilyName" : {
                "PreviousFamilyName" : [ {
                  "previousFamilyName" : "$nav.andrepersoner[x].bruker.person.tidligereetternavn[x].navn"
                } ]
              },
              "currentFamilyStatus" : {
                "value" : [ "$nav.andrepersoner[x].bruker.familiestatus.RFamilyStatusType" ]
              },
              "dateDeath" : "$nav.andrepersoner[x].bruker.doedsdato",
              "nationality" : {
                "value" : [ "$nav.andrepersoner[x].bruker.statsborgerskap.land" ]
              }
            }
          },
          "ThirdPartyStatus" : {
            "StatusPersonThirdParty" : {
              "value" : [ "$nav.andrepersoner[x].bruker.personstatus.RStatusPersonThirdPartyType" ]
            },
            "PleaseFillInFollowingIfStatusPersonOther" : {
              "otherStatusPerson" : "$nav.andrepersoner[x].bruker.personstatus.annen"
            }
          }
        } ]
      }
    },
    "EntitlementBenefits" : {
      "entitlementBenefitsIndicator" : {
        "value" : [ "$tilbakekreving.retttilytelser.harretttilytelser" ]
      },
      "requestHasBeenMadeWithin3MonthsPeriodIndicator" : {
        "value" : [ "$tilbakekreving.retttilytelser.anmodning.erfremsattinnentremaaneder" ]
      }
    },
    "AdditionalInformation" : {
      "additionalInformation" : "$nav.ytterligereinformasjon"
    },
    "LocalCaseNumbers" : {
      "LocalCaseNumber" : [ {
        "Institution" : {
          "institutionID" : "$nav.eessisak[x].institusjonsid",
          "institutionName" : "$nav.eessisak[x].institusjonsnavn"
        },
        "country" : {
          "value" : [ "$nav.eessisak[x].land" ]
        },
        "caseNumber" : "$nav.eessisak[x].saksnummer"
      } ]
    }
  }
}