{
  "DA049" : {
    "Employer" : {
      "IdentificationNumbers" : {
        "IdentificationNumber" : [ {
          "number" : "$nav.arbeidsgiver.identifikator[x].id",
          "type" : {
            "value" : [ "$nav.arbeidsgiver.identifikator[x].type" ]
          }
        } ]
      },
      "Address" : {
        "postalCode" : "$nav.arbeidsgiver.adresse.postnummer",
        "country" : {
          "value" : [ "$nav.arbeidsgiver.adresse.land" ]
        },
        "buildingName" : "$nav.arbeidsgiver.adresse.bygning",
        "region" : "$nav.arbeidsgiver.adresse.region",
        "street" : "$nav.arbeidsgiver.adresse.gate",
        "town" : "$nav.arbeidsgiver.adresse.by"
      },
      "name" : "$nav.arbeidsgiver.navn"
    },
    "AddressesPerson" : {
      "AddressPerson" : [ {
        "postalCode" : "$nav.bruker.adresse[x].postnummer",
        "region" : "$nav.bruker.adresse[x].region",
        "street" : "$nav.bruker.adresse[x].gate",
        "buildingName" : "$nav.bruker.adresse[x].bygning",
        "town" : "$nav.bruker.adresse[x].by",
        "country" : {
          "value" : [ "$nav.bruker.adresse[x].land" ]
        }
      } ]
    },
    "Person" : {
      "PersonIdentification" : {
        "IfPINNotProvidedForEveryInstitutionPleaseProvide" : {
          "motherFamilyNameAtBirth" : "$nav.bruker.mor.person.etternavnvedfoedsel",
          "PlaceBirth" : {
            "town" : "$nav.bruker.person.foedested.by",
            "region" : "$nav.bruker.person.foedested.region",
            "country" : {
              "value" : [ "$nav.bruker.person.foedested.land" ]
            }
          },
          "forenameMother" : "$nav.bruker.mor.person.fornavn",
          "fatherFamilyNameAtBirth" : "$nav.bruker.far.person.etternavnvedfoedsel",
          "forenameFather" : "$nav.bruker.far.person.fornavn"
        },
        "PINPersonInEachInstitution" : {
          "PersonalIdentificationNumber" : [ {
            "Institution" : {
              "institutionName" : "$nav.bruker.person.pin[x].institusjonsnavn",
              "institutionID" : "$nav.bruker.person.pin[x].institusjonsid"
            },
            "personalIdentificationNumber" : "$nav.bruker.person.pin[x].identifikator",
            "sector" : {
              "value" : [ "$nav.bruker.person.pin[x].sektor" ]
            },
            "country" : {
              "value" : [ "$nav.bruker.person.pin[x].land" ]
            }
          } ]
        },
        "forename" : "$nav.bruker.person.fornavn",
        "dateBirth" : "$nav.bruker.person.foedselsdato",
        "sex" : {
          "value" : [ "$nav.bruker.person.kjoenn" ]
        },
        "forenameAtBirth" : "$nav.bruker.person.fornavnvedfoedsel",
        "familyName" : "$nav.bruker.person.etternavn",
        "familyNameAtBirth" : "$nav.bruker.person.etternavnvedfoedsel"
      },
      "AdditionalInformationPerson" : {
        "previousForename" : "$nav.bruker.person.tidligerefornavn",
        "nationality" : {
          "value" : [ "$nav.bruker.person.statsborgerskap[x].land" ]
        },
        "previousFamilyName" : "$nav.bruker.person.tidligereetternavn"
      }
    },
    "Decision" : {
      "InformationAboutSicknessInsurance" : {
        "FillInIfSicknessInsurance" : {
          "Institution" : {
            "institutionID" : "$arbeidsulykkeyrkessykdom.bestridelse.endeligvedtak.sykeforsikring.institusjonsid",
            "institutionName" : "$arbeidsulykkeyrkessykdom.bestridelse.endeligvedtak.sykeforsikring.institusjonsnavn"
          },
          "countryCode" : {
            "value" : [ "$arbeidsulykkeyrkessykdom.bestridelse.endeligvedtak.sykeforsikring.land" ]
          }
        },
        "sicknessInsuranceInformation" : {
          "value" : [ "$arbeidsulykkeyrkessykdom.bestridelse.endeligvedtak.sykeforsikring.status.type" ]
        }
      },
      "FillInIfReasonForConditions" : {
        "otherReason" : "$arbeidsulykkeyrkessykdom.bestridelse.endeligvedtak.betingelser.ikkeoppfylt.grunn.annet"
      },
      "reasonForConditionForAccidentWorkDiseaseNotFulfilled" : {
        "value" : [ "$arbeidsulykkeyrkessykdom.bestridelse.endeligvedtak.betingelser.ikkeoppfylt.grunn.type[x]" ]
      },
      "conditionsAnAccidentAtWorkAnOccupationalDiseaseAre" : {
        "value" : [ "$arbeidsulykkeyrkessykdom.bestridelse.endeligvedtak.betingelser.status.type" ]
      }
    },
    "ThisSEDRelatedTo" : {
      "statusPerson" : {
        "value" : [ "$arbeidsulykkeyrkessykdom.sedrelaterttil.aktivitet.status.id" ]
      },
      "typeOfSED" : {
        "value" : [ "$arbeidsulykkeyrkessykdom.sedrelaterttil.sedtype" ]
      },
      "PleaseFillInFollowingIfStatusPersonOther" : {
        "statusPersonIfOther" : "$arbeidsulykkeyrkessykdom.sedrelaterttil.aktivitet.status.annet"
      },
      "code" : "$arbeidsulykkeyrkessykdom.sedrelaterttil.sykdom.kode",
      "codingSystem" : "$arbeidsulykkeyrkessykdom.sedrelaterttil.sykdom.kodingssystem",
      "description" : "$arbeidsulykkeyrkessykdom.sedrelaterttil.konsekvensellerbeskrivelse",
      "date" : "$arbeidsulykkeyrkessykdom.sedrelaterttil.dato"
    },
    "AdditionalInformation" : {
      "additionalInformation" : "$nav.ytterligereinformasjon"
    }
  }
}