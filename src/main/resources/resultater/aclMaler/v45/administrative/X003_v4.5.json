        "sex" : {
          "value" : [ "$nav.sak.kontekst.bruker.person.kjoenn" ]
        },
        "dateBirth" : "$nav.sak.kontekst.bruker.person.foedselsdato",
        "familyName" : "$nav.sak.kontekst.bruker.person.etternavn"
      }
    },
    "AgreementReopening" : {
      "agreementReopeningIndicator" : {
        "value" : [ "$nav.sak.admodning.gjenaapning.svar.ergodkjent" ]
      },
      "reason" : {
        "value" : [ "$nav.sak.admodning.gjenaapning.svar.grunn.type" ]
      },
      "pleaseProvideMoreDetailsIf99OtherSelected" : "$nav.sak.admodning.gjenaapning.svar.grunn.annet"
    }
  }
}