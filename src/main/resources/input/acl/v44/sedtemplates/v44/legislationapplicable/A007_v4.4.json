{
  "A007" : {
    "Person" : {
      "PersonIdentification" : {
        "PINPersonInEachInstitution" : {
          "PersonalIdentificationNumber" : [ {
            "Institution" : {
              "institutionID" : "$nav.bruker.person.pin[x].institusjonsid",
              "institutionName" : "$nav.bruker.person.pin[x].institusjonsnavn"
            },
            "sector" : {
              "value" : [ "$nav.bruker.person.pin[x].sektor" ]
            },
            "country" : {
              "value" : [ "$nav.bruker.person.pin[x].land" ]
            },
            "personalIdentificationNumber" : "$nav.bruker.person.pin[x].identifikator"
          } ]
        },
        "familyNameAtBirth" : "$nav.bruker.person.etternavnvedfoedsel",
        "dateBirth" : "$nav.bruker.person.foedselsdato",
        "IfPINNotProvidedForEveryInstitutionPleaseProvide" : {
          "PlaceBirth" : {
            "country" : {
              "value" : [ "$nav.bruker.person.foedested.land" ]
            },
            "town" : "$nav.bruker.person.foedested.by",
            "region" : "$nav.bruker.person.foedested.region"
          },
          "forenameFather" : "$nav.bruker.far.person.fornavn",
          "forenameMother" : "$nav.bruker.mor.person.fornavn",
          "motherFamilyNameAtBirth" : "$nav.bruker.mor.person.etternavnvedfoedsel",
          "fatherFamilyNameAtBirth" : "$nav.bruker.far.person.etternavnvedfoedsel"
        },
        "sex" : {
          "value" : [ "$nav.bruker.person.kjoenn" ]
        },
        "forename" : "$nav.bruker.person.fornavn",
        "forenameAtBirth" : "$nav.bruker.person.fornavnvedfoedsel",
        "familyName" : "$nav.bruker.person.etternavn"
      },
      "AdditionalInformationPerson" : {
        "nationality" : {
          "value" : [ "$nav.bruker.person.statsborgerskap[x].land" ]
        }
      }
    },
    "PlaceWork" : {
      "CountriesWork" : [ {
        "PlaceWork" : {
          "PlaceWork" : [ {
            "companyNameVesselName" : "$nav.arbeidsland[x].arbeidssted[x].navn",
            "Address" : {
              "town" : "$nav.arbeidsland[x].arbeidssted[x].adresse.by",
              "street" : "$nav.arbeidsland[x].arbeidssted[x].adresse.gate",
              "postalCode" : "$nav.arbeidsland[x].arbeidssted[x].adresse.postnummer",
              "buildingName" : "$nav.arbeidsland[x].arbeidssted[x].adresse.bygning",
              "region" : "$nav.arbeidsland[x].arbeidssted[x].adresse.region"
            },
            "flagStatehomeBase" : "$nav.arbeidsland[x].arbeidssted[x].hjemmebase"
          } ]
        },
        "countryWork" : {
          "value" : [ "$nav.arbeidsland[x].land" ]
        }
      } ],
      "aFixedPlaceWorkExistsIndicator" : {
        "value" : [ "$nav.harfastarbeidssted" ]
      }
    },
    "Employer" : {
      "Employer" : [ {
        "IdentificationNumbers" : {
          "IdentificationNumber" : [ {
            "number" : "$nav.arbeidsgiver[x].identifikator[x].id",
            "type" : {
              "value" : [ "$nav.arbeidsgiver[x].identifikator[x].type" ]
            }
          } ]
        },
        "Address" : {
          "town" : "$nav.arbeidsgiver[x].adresse.by",
          "region" : "$nav.arbeidsgiver[x].adresse.region",
          "country" : {
            "value" : [ "$nav.arbeidsgiver[x].adresse.land" ]
          },
          "buildingName" : "$nav.arbeidsgiver[x].adresse.bygning",
          "postalCode" : "$nav.arbeidsgiver[x].adresse.postnummer",
          "street" : "$nav.arbeidsgiver[x].adresse.gate"
        },
        "name" : "$nav.arbeidsgiver[x].navn"
      } ]
    },
    "AdditionalInformation" : {
      "additionalInformation" : "$nav.ytterligereinformasjon"
    },
    "SelfEmployment" : {
      "SelfEmployment" : [ {
        "IdentificationNumbers" : {
          "IdentificationNumber" : [ {
            "number" : "$nav.selvstendig.arbeidsgiver[x].identifikator[x].id",
            "type" : {
              "value" : [ "$nav.selvstendig.arbeidsgiver[x].identifikator[x].type" ]
            }
          } ]
        },
        "Address" : {
          "street" : "$nav.selvstendig.arbeidsgiver[x].adresse.gate",
          "buildingName" : "$nav.selvstendig.arbeidsgiver[x].adresse.bygning",
          "country" : {
            "value" : [ "$nav.selvstendig.arbeidsgiver[x].adresse.land" ]
          },
          "town" : "$nav.selvstendig.arbeidsgiver[x].adresse.by",
          "postalCode" : "$nav.selvstendig.arbeidsgiver[x].adresse.postnummer",
          "region" : "$nav.selvstendig.arbeidsgiver[x].adresse.region"
        },
        "name" : "$nav.selvstendig.arbeidsgiver[x].navn"
      } ]
    },
    "ProvisionalDecisionApplicableLegislation" : {
      "memberStateWhichLegislationApplies" : {
        "value" : [ "$medlemskap.midlertidigvedtak.gjeldenelovgivning.land" ]
      },
      "determinationAccordingTo" : {
        "value" : [ "$medlemskap.midlertidigvedtak.isamsvarmedartikkel" ]
      },
      "dateRequestAccording61c" : "$medlemskap.midlertidigvedtak.amnodningsdatoisamsvarmed61c",
      "startingDate" : "$medlemskap.midlertidigvedtak.startdato"
    },
    "Addresses" : {
      "Address" : [ {
        "Address" : {
          "country" : {
            "value" : [ "$nav.bruker.adresse[x].land" ]
          },
          "town" : "$nav.bruker.adresse[x].by",
          "buildingName" : "$nav.bruker.adresse[x].bygning",
          "postalCode" : "$nav.bruker.adresse[x].postnummer",
          "region" : "$nav.bruker.adresse[x].region",
          "street" : "$nav.bruker.adresse[x].gate"
        },
        "type" : {
          "value" : [ "$nav.bruker.adresse[x].type" ]
        }
      } ]
    },
    "CompetentInstitutionIfDiffersFromSending" : {
      "institutionName" : "$nav.eessisak.institusjonsnummer",
      "institutionID" : "$nav.eessisak.institusjonsid"
    },
    "StatusPerson" : {
      "statusPerson" : {
        "value" : [ "$medlemskap.bruker.status" ]
      }
    }
  }
}