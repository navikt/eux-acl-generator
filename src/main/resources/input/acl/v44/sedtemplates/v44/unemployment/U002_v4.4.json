{
  "U002" : {
    "UnemploymentBenefitsPeriods" : {
      "UnemploymentBenefitsPeriod" : [ {
        "Period" : {
          "OpenPeriod" : {
            "typeOpenPeriod" : {
              "value" : [ "$dagpenger.anmodningominformasjon.svar.dagpengeperioder[x].periode.aapenperiode.type" ]
            },
            "startDate" : "$dagpenger.anmodningominformasjon.svar.dagpengeperioder[x].periode.aapenperiode.startdato"
          },
          "FixedPeriod" : {
            "startDate" : "$dagpenger.anmodningominformasjon.svar.dagpengeperioder[x].periode.fastperiode.startdato",
            "endDate" : "$dagpenger.anmodningominformasjon.svar.dagpengeperioder[x].periode.fastperiode.sluttdato"
          }
        },
        "LocalInstitution" : {
          "TheInstitutionDOESNOTExistInIR" : {
            "institutionName" : "$dagpenger.anmodningominformasjon.svar.dagpengeperioder[x].institusjon.ukjentid.navn",
            "InstitutionAddress" : {
              "street" : "$dagpenger.anmodningominformasjon.svar.dagpengeperioder[x].institusjon.ukjentid.adresse.gate",
              "postalCode" : "$dagpenger.anmodningominformasjon.svar.dagpengeperioder[x].institusjon.ukjentid.adresse.postnummer",
              "town" : "$dagpenger.anmodningominformasjon.svar.dagpengeperioder[x].institusjon.ukjentid.adresse.by",
              "buildingName" : "$dagpenger.anmodningominformasjon.svar.dagpengeperioder[x].institusjon.ukjentid.adresse.bygning",
              "country" : {
                "value" : [ "$dagpenger.anmodningominformasjon.svar.dagpengeperioder[x].institusjon.ukjentid.adresse.land" ]
              },
              "region" : "$dagpenger.anmodningominformasjon.svar.dagpengeperioder[x].institusjon.ukjentid.adresse.region"
            }
          },
          "TheInstitutionEXISTSInIR" : {
            "institutionName" : "$dagpenger.anmodningominformasjon.svar.dagpengeperioder[x].institusjon.navn",
            "institutionID" : "$dagpenger.anmodningominformasjon.svar.dagpengeperioder[x].institusjon.id"
          }
        }
      } ]
    },
    "PeriodsInsuranceEmploymentOrSelfEmployment" : {
      "InsuranceOrEmploymentOrSelfEmploymentPeriod" : [ {
        "typePeriod" : {
          "value" : [ "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].typeperiode42" ]
        },
        "FillInIfTypePeriodOtherPeriod" : {
          "FillInIfTypeOtherPeriodTreated" : {
            "typeOtherPeriod" : "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].periodeannenforsikring.behandlessomtrygdeperiode"
          },
          "FillInIfTypeCompensation" : {
            "VacationNotTaken" : {
              "Amount" : {
                "amount" : "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].periodeannenforsikring.feriepengerikketattut.beloep",
                "currency" : {
                  "value" : [ "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].periodeannenforsikring.feriepengerikketattut.valuta" ]
                }
              }
            }
          },
          "type" : {
            "value" : [ "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].periodeannenforsikring.type42" ]
          }
        },
        "FillInIfTypePeriodEmploymentNot" : {
          "RequestedAdditionalDetails" : {
            "EarningsOrHours" : {
              "EarningsOrHours" : [ {
                "numberWorkingHours" : "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].ansattutenforsikring.timerellerinntekt[x].antallarbeidstimer",
                "Period" : {
                  "FixedPeriod" : {
                    "startDate" : "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].ansattutenforsikring.timerellerinntekt[x].fastperiode.startdato",
                    "endDate" : "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].ansattutenforsikring.timerellerinntekt[x].fastperiode.sluttdato"
                  },
                  "OpenPeriod" : {
                    "typeOpenPeriod" : {
                      "value" : [ "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].ansattutenforsikring.timerellerinntekt[x].aapenperiode.type" ]
                    },
                    "startDate" : "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].ansattutenforsikring.timerellerinntekt[x].aapenperiode.startdato"
                  }
                },
                "GrossEarnings" : {
                  "currency" : {
                    "value" : [ "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].ansattutenforsikring.timerellerinntekt[x].valuta" ]
                  },
                  "amount" : "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].ansattutenforsikring.timerellerinntekt[x].bruttoinntekt"
                }
              } ]
            },
            "employmentOrSelfEmploymentNature" : "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].ansattutenforsikring.ertimerellerinntekt"
          },
          "EmployerOrSelfEmploymentDetails" : {
            "name" : "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].ansattutenforsikring.arbeidsgiver.navn",
            "Address" : {
              "street" : "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].ansattutenforsikring.arbeidsgiver.adresse.gate",
              "town" : "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].ansattutenforsikring.arbeidsgiver.adresse.by",
              "country" : {
                "value" : [ "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].ansattutenforsikring.arbeidsgiver.adresse.land" ]
              },
              "region" : "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].ansattutenforsikring.arbeidsgiver.adresse.region",
              "buildingName" : "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].ansattutenforsikring.arbeidsgiver.adresse.bygning",
              "postalCode" : "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].ansattutenforsikring.arbeidsgiver.adresse.postnummer"
            },
            "IdentificationNumbers" : {
              "IdentificationNumber" : [ {
                "type" : {
                  "value" : [ "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].ansattutenforsikring.arbeidsgiver.identifikator[x].type42" ]
                },
                "number" : "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].ansattutenforsikring.arbeidsgiver.identifikator[x].id"
              } ]
            }
          }
        },
        "Period" : {
          "FixedPeriod" : {
            "endDate" : "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].periode.fastperiode.sluttdato",
            "startDate" : "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].periode.fastperiode.startdato"
          },
          "OpenPeriod" : {
            "typeOpenPeriod" : {
              "value" : [ "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].periode.aapenperiode.type" ]
            },
            "startDate" : "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].periode.aapenperiode.startdato"
          }
        },
        "FillInIfTypePeriodEmployment" : {
          "EmployerOrSelfEmploymentDetails" : {
            "Address" : {
              "postalCode" : "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].ansattmedforsikring.arbeidsgiver.adresse.postnummer",
              "country" : {
                "value" : [ "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].ansattmedforsikring.arbeidsgiver.adresse.land" ]
              },
              "buildingName" : "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].ansattmedforsikring.arbeidsgiver.adresse.bygning",
              "street" : "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].ansattmedforsikring.arbeidsgiver.adresse.gate",
              "town" : "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].ansattmedforsikring.arbeidsgiver.adresse.by",
              "region" : "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].ansattmedforsikring.arbeidsgiver.adresse.region"
            },
            "IdentificationNumbers" : {
              "IdentificationNumber" : [ {
                "number" : "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].ansattmedforsikring.arbeidsgiver.identifikator[x].id",
                "type" : {
                  "value" : [ "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].ansattmedforsikring.arbeidsgiver.identifikator[x].type42" ]
                }
              } ]
            },
            "name" : "$dagpenger.anmodningominformasjon.svar.trygdehistorikk[x].ansattmedforsikring.arbeidsgiver.navn"
          }
        }
      } ]
    },
    "Person" : {
      "PersonIdentification" : {
        "IfPINNotProvidedForEveryInstitutionPleaseProvide" : {
          "PlaceBirth" : {
            "region" : "$nav.bruker.person.foedested.region",
            "country" : {
              "value" : [ "$nav.bruker.person.foedested.land" ]
            },
            "town" : "$nav.bruker.person.foedested.by"
          },
          "forenameMother" : "$nav.bruker.mor.person.fornavn",
          "fatherFamilyNameAtBirth" : "$nav.bruker.far.person.etternavnvedfoedsel",
          "motherFamilyNameAtBirth" : "$nav.bruker.mor.person.etternavnvedfoedsel",
          "forenameFather" : "$nav.bruker.far.person.fornavn"
        },
        "PINPersonInEachInstitution" : {
          "PersonalIdentificationNumber" : [ {
            "Institution" : {
              "institutionName" : "$nav.bruker.person.pin[x].institusjonsnavn",
              "institutionID" : "$nav.bruker.person.pin[x].institusjonsid"
            },
            "country" : {
              "value" : [ "$nav.bruker.person.pin[x].land" ]
            },
            "sector" : {
              "value" : [ "$nav.bruker.person.pin[x].sektor" ]
            },
            "personalIdentificationNumber" : "$nav.bruker.person.pin[x].identifikator"
          } ]
        },
        "forenameAtBirth" : "$nav.bruker.person.fornavnvedfoedsel",
        "familyName" : "$nav.bruker.person.etternavn",
        "sex" : {
          "value" : [ "$nav.bruker.person.kjoenn" ]
        },
        "dateBirth" : "$nav.bruker.person.foedselsdato",
        "forename" : "$nav.bruker.person.fornavn",
        "familyNameAtBirth" : "$nav.bruker.person.etternavnvedfoedsel"
      },
      "AdditionalInformationPerson" : {
        "nationality" : {
          "value" : [ "$nav.bruker.person.statsborgerskap[x].land" ]
        }
      }
    },
    "ElementsConcerningLastEmploymentOrSelfEmployment" : {
      "TypeAmounts" : [ {
        "TypeAmount" : {
          "Payment" : {
            "currency" : {
              "value" : [ "$dagpenger.anmodningominformasjon.svar.sisteansettelse.ytterligereinformasjon.utbetaling[x].valuta" ]
            },
            "amount" : "$dagpenger.anmodningominformasjon.svar.sisteansettelse.ytterligereinformasjon.utbetaling[x].beloep"
          },
          "typeAmount" : {
            "value" : [ "$dagpenger.anmodningominformasjon.svar.sisteansettelse.ytterligereinformasjon.utbetaling[x].typebeloep" ]
          }
        },
        "FillInIfTypeAmountWagesReceived" : {
          "receivedForPeriodUntil" : "$dagpenger.anmodningominformasjon.svar.sisteansettelse.ytterligereinformasjon.utbetaling[x].loennetteransettelse.fremtil"
        },
        "FillInIfTypeAmountCompensation" : {
          "numberDays" : "$dagpenger.anmodningominformasjon.svar.sisteansettelse.ytterligereinformasjon.utbetaling[x].feriepengerikketattut.antalldager"
        }
      } ],
      "otherBenefits" : "$dagpenger.anmodningominformasjon.svar.sisteansettelse.ytterligereinformasjon.andreytelser",
      "WaivedRight" : {
        "reason" : "$dagpenger.anmodningominformasjon.svar.sisteansettelse.ytterligereinformasjon.avkallrettigheter.grunn",
        "waivedRights" : "$dagpenger.anmodningominformasjon.svar.sisteansettelse.ytterligereinformasjon.avkallrettigheter.rettigheter"
      }
    },
    "LocalCaseNumbers" : {
      "LocalCaseNumber" : [ {
        "caseNumber" : "$nav.eessisak[x].saksnummer",
        "Institution" : {
          "institutionName" : "$nav.eessisak[x].institusjonsnavn",
          "institutionID" : "$nav.eessisak[x].institusjonsid"
        },
        "country" : {
          "value" : [ "$nav.eessisak[x].land" ]
        }
      } ]
    },
    "ReferencePeriod" : {
      "FixedPeriod" : {
        "startDate" : "$dagpenger.anmodningominformasjon.anmodningsperiode.fastperiode.startdato",
        "endDate" : "$dagpenger.anmodningominformasjon.anmodningsperiode.fastperiode.sluttdato"
      },
      "OpenPeriod" : {
        "startDate" : "$dagpenger.anmodningominformasjon.anmodningsperiode.aapenperiode.startdato",
        "typeOpenPeriod" : {
          "value" : [ "$dagpenger.anmodningominformasjon.anmodningsperiode.aapenperiode.type" ]
        }
      }
    },
    "ReasonForTerminationLastEmploymentOrSelf" : {
      "terminationReasonSelfEmployment" : "$dagpenger.anmodningominformasjon.svar.sisteansettelse.informasjonomopphoer.selvstendig.aarsak",
      "FillInIfTerminationReason" : {
        "otherTermination" : "$dagpenger.anmodningominformasjon.svar.sisteansettelse.informasjonomopphoer.ansettelse.annen"
      },
      "terminationReasonEmployment" : {
        "value" : [ "$dagpenger.anmodningominformasjon.svar.sisteansettelse.informasjonomopphoer.ansettelse.aarsak" ]
      }
    }
  }
}