{
  "U025" : {
    "GeneralInformation" : {
      "AmountReceived" : {
        "currency" : {
          "value" : [ "$dagpenger.refusjonskrav.tilbakebetaling.valuta" ]
        },
        "amount" : "$dagpenger.refusjonskrav.tilbakebetaling.beloep"
      },
      "reimbursementReceiptOrClosingNotificationID" : "$dagpenger.refusjonskrav.tilbakebetaling.kvittering.id",
      "datePaymentReceived" : "$dagpenger.refusjonskrav.tilbakebetaling.utbetalingsdato",
      "reimbursementRequestID" : "$dagpenger.refusjonskrav.id",
      "reimbursementPaymentNotificationID" : "$dagpenger.refusjonskrav.tilbakebetaling.id"
    },
    "LocalCaseNumbers" : {
      "LocalCaseNumber" : [ {
        "Institution" : {
          "institutionName" : "$nav.eessisak[x].institusjonsnavn",
          "institutionID" : "$nav.eessisak[x].institusjonsid"
        },
        "caseNumber" : "$nav.eessisak[x].saksnummer",
        "country" : {
          "value" : [ "$nav.eessisak[x].land" ]
        }
      } ]
    },
    "ReimbursementRequestClosed" : {
      "FillInIfReimbursementRequestNotClosed" : {
        "reasonForNotClosingReimbursementRequest" : {
          "value" : [ "$dagpenger.refusjonskrav.ikkeavsluttet.grunn.type[x]" ]
        },
        "PleaseFillInFollowingIfReasonOtherReason" : {
          "reason" : "$dagpenger.refusjonskrav.ikkeavsluttet.grunn.annen"
        }
      },
      "reimbursementRequestClosedIndicator" : {
        "value" : [ "$dagpenger.refusjonskrav.eravsluttet" ]
      }
    }
  }
}