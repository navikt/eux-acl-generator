{
  "H020" : {
    "GlobalClaim" : {
      "TotalClaimAmountInCurrencyCreditorInstitution" : {
        "amount" : "$horisontal.refusjonskrav.kreditorinstitusjon.krav.totalbeloep",
        "paymentDueOn" : "$horisontal.refusjonskrav.kreditorinstitusjon.krav.forfallsdato",
        "currency" : {
          "value" : [ "$horisontal.refusjonskrav.kreditorinstitusjon.krav.valuta" ]
        }
      },
      "globalReferenceSetByCreditorInstitution" : "$horisontal.refusjonskrav.kreditorinstitusjon.globalreferanse",
      "CreditorInstitution" : {
        "institutionID" : "$horisontal.refusjonskrav.kreditorinstitusjon.id",
        "institutionName" : "$horisontal.refusjonskrav.kreditorinstitusjon.navn"
      },
      "BankDetails" : {
        "BICSWIFT" : "$horisontal.refusjonskrav.bank.konto.sepa.swift",
        "IBAN" : "$horisontal.refusjonskrav.bank.konto.sepa.iban"
      },
      "DebtorInstitution" : {
        "institutionID" : "$horisontal.refusjonskrav.debitorinstitusjon.id",
        "institutionName" : "$horisontal.refusjonskrav.debitorinstitusjon.navn"
      },
      "totalNumberInvoices" : "$horisontal.refusjonskrav.totaltantallfakturaer"
    },
    "Claim" : {
      "Person" : {
        "PersonInformation" : {
          "familyName" : "$nav.bruker.person.etternavn",
          "forename" : "$nav.bruker.person.fornavn",
          "sex" : {
            "value" : [ "$nav.bruker.person.kjoenn" ]
          },
          "dateBirth" : "$nav.bruker.person.foedselsdato"
        },
        "familyNameAtBirth" : "$nav.bruker.person.etternavnvedfoedsel",
        "PersonIdentificationNumber" : {
          "pINPersonInCompetentMemberState" : "$nav.bruker.person.pin.identifikator",
          "pINPersonInMemberStateStayOrResidence" : "$nav.bruker.person.oppholdsland.pin"
        },
        "forenameAtBirth" : "$nav.bruker.person.fornavnvedfoedsel"
      },
      "Reimbursement" : [ {
        "inReferenceYour" : {
          "value" : [ "$horisontal.refusjonskrav.refusjon[x].henvisningtil" ]
        },
        "InvoiceAmountInCurrencyCreditorInstitution" : {
          "currency" : {
            "value" : [ "$horisontal.refusjonskrav.refusjon[x].kreditorinstitusjon.valuta" ]
          },
          "amount" : "$horisontal.refusjonskrav.refusjon[x].kreditorinstitusjon.beloep"
        },
        "invoiceNumberCreditorInstitution" : "$horisontal.refusjonskrav.refusjon[x].kreditorinstitusjon.fakturanummer",
        "issuedOn" : "$horisontal.refusjonskrav.refusjon[x].utstedelsesdato"
      } ]
    }
  }
}