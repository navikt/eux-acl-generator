{
  "H121" : {
    "AdditionalInformation" : {
      "additionalInformation" : "$nav.ytterligereinformasjon"
    },
    "NotificationMedicalInformation" : {
      "NotificationMedicalInformation" : {
        "otherMedicalInformation" : "$horisontal.anmodningmedisinskinformasjon.svar.medisinsk.informasjon.annen",
        "pleaseFindAttached" : {
          "value" : [ "$horisontal.anmodningmedisinskinformasjon.svar.medisinsk.informasjon.type43" ]
        }
      }
    },
    "Person" : {
      "AdditionalInformationPerson" : {
        "nationality" : {
          "value" : [ "$nav.bruker.person.statsborgerskap[x].land" ]
        },
        "previousFamilyName" : "$nav.endredeforhold.bruker.person.tidligereetternavn",
        "previousForename" : "$nav.endredeforhold.bruker.person.tidligerefornavn"
      },
      "PersonIdentification" : {
        "IfPINNotProvidedForEveryInstitutionPleaseProvide" : {
          "PlaceBirth" : {
            "country" : {
              "value" : [ "$nav.bruker.person.foedested.land" ]
            },
            "region" : "$nav.bruker.person.foedested.region",
            "town" : "$nav.bruker.person.foedested.by"
          },
          "fatherFamilyNameAtBirth" : "$nav.bruker.far.person.etternavnvedfoedsel",
          "forenameFather" : "$nav.bruker.far.person.fornavn",
          "forenameMother" : "$nav.bruker.mor.person.fornavn",
          "motherFamilyNameAtBirth" : "$nav.bruker.mor.person.etternavnvedfoedsel"
        },
        "PINPersonInEachInstitution" : {
          "PersonalIdentificationNumber" : [ {
            "Institution" : {
              "institutionID" : "$nav.bruker.person.pin[x].institusjonsid",
              "institutionName" : "$nav.bruker.person.pin[x].institusjonsnavn"
            },
            "country" : {
              "value" : [ "$nav.bruker.person.pin[x].land" ]
            },
            "personalIdentificationNumber" : "$nav.bruker.person.pin[x].identifikator",
            "sector" : {
              "value" : [ "$nav.bruker.person.pin[x].sektor" ]
            }
          } ]
        },
        "dateBirth" : "$nav.bruker.person.foedselsdato",
        "familyName" : "$nav.bruker.person.etternavn",
        "familyNameAtBirth" : "$nav.bruker.person.etternavnvedfoedsel",
        "forename" : "$nav.bruker.person.fornavn",
        "forenameAtBirth" : "$nav.bruker.person.fornavnvedfoedsel",
        "sex" : {
          "value" : [ "$nav.bruker.person.kjoenn" ]
        }
      }
    },
    "ReplyRequestForEstimatedCostsMedicalEvidence" : {
      "ReplyRequestForEstimatedCostsMedicalEvidence" : {
        "currency" : {
          "value" : [ "$horisontal.anmodningmedisinskinformasjon.svar.undersoekelse.estimat.kostnader.valuta" ]
        },
        "replyForEstimatedCostsForMedicalEvidenceExamination" : "$horisontal.anmodningmedisinskinformasjon.svar.undersoekelse.estimat.kostnader.beloep"
      }
    },
    "ReplyRequestForMedicalEvidence" : {
      "ReplyRequestForMedicalEvidence" : {
        "reasonsForNotSendingRequestedMedicalEvidence" : "$horisontal.anmodningmedisinskinformasjon.svar.dokumentasjonikkevedlagt.grunn",
        "replyAttachedRequestedMedicalEvidenceIndicator" : {
          "value" : [ "$horisontal.anmodningmedisinskinformasjon.svar.erdokumentasjonsvedlagt" ]
        }
      }
    },
    "ReplyRequestForMedicalExaminationReport" : {
      "ReplyRequestForMedicalExaminationReport" : {
        "FillInIfReasonForNotCarryingOut" : {
          "otherReason" : "$horisontal.anmodningmedisinskinformasjon.svar.medisinsk.undersoekelse.ikkegjennomfoert.grunn.annen"
        },
        "inReplyRequestConcerningMedicalExaminationInformIt" : {
          "value" : [ "$horisontal.anmodningmedisinskinformasjon.svar.medisinsk.undersoekelse.type" ]
        },
        "reasonForNotCarryingOutMedicalExamination" : {
          "value" : [ "$horisontal.anmodningmedisinskinformasjon.svar.medisinsk.undersoekelse.ikkegjennomfoert.grunn.type" ]
        }
      }
    },
    "sedGVer" : "$sedGVer",
    "sedVer" : "$sedVer"
  }
}