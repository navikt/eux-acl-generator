{
	"R006": {
		"sedGVer": "$sedGVer",
		"sedVer": "$sedVer",
		"LocalCaseNumbers": {
			"LocalCaseNumber": [
				{
					"country": {
						"value": [
							"$nav.eessisak[x].land"
						]
					},
					"caseNumber": "$nav.eessisak[x].saksnummer",
					"Institution": {
						"institutionID": "$nav.eessisak[x].institusjonsid",
						"institutionName": "$nav.eessisak[x].institusjonsnavn"
					}
				}
			]
		},
		"Persons": {
			"Person": [
				{
					"PersonIdentification": {
						"familyName": "$nav.brukere[x].person.etternavn",
						"forename": "$nav.brukere[x].person.fornavn",
						"dateBirth": "$nav.brukere[x].person.foedselsdato",
						"sex": {
							"value": [
								"$nav.brukere[x].person.kjoenn"
							]
						},
						"familyNameAtBirth": "$nav.brukere[x].person.etternavnvedfoedsel",
						"forenameAtBirth": "$nav.brukere[x].person.fornavnvedfoedsel",
						"PINPersonInEachInstitution": {
							"PersonalIdentificationNumber": [
								{
									"country": {
										"value": [
											"$nav.brukere[x].person.pin[x].land"
										]
									},
									"personalIdentificationNumber": "$nav.brukere[x].person.pin[x].identifikator",
									"sector": {
										"value": [
											"$nav.brukere[x].person.pin[x].sektor"
										]
									},
									"Institution": {
										"institutionID": "$nav.brukere[x].person.pin[x].institusjonsid",
										"institutionName": "$nav.brukere[x].person.pin[x].institusjonsnavn"
									}
								}
							]
						},
						"IfPINNotProvidedForEveryInstitutionPleaseProvide": {
							"PlaceBirth": {
								"town": "$nav.brukere[x].person.foedested.by",
								"region": "$nav.brukere[x].person.foedested.region",
								"country": {
									"value": [
										"$nav.brukere[x].person.foedested.land"
									]
								}
							},
							"fatherFamilyNameAtBirth": "$nav.brukere[x].far.person.etternavnvedfoedsel",
							"forenameFather": "$nav.brukere[x].far.person.fornavn",
							"motherFamilyNameAtBirth": "$nav.brukere[x].mor.person.etternavnvedfoedsel",
							"forenameMother": "$nav.brukere[x].mor.person.fornavn"
						}
					},
					"AdditionalInformationAboutPerson": {
						"statusPerson": {
							"value": [
								"$nav.brukere[x].tilbakekreving.status.type"
							]
						},
						"PleaseFillInFollowingIfStatusPersonOther": {
							"otherStatusPerson": "$nav.brukere[x].tilbakekreving.status.annen"
						},
						"nationality": {
							"value": [
								"$nav.brukere[x].person.statsborgerskap[x].land"
							]
						},
						"PreviousFamilyNames": {
							"PreviousFamilyName": [
								{
									"previousFamilyName": "$tilbakekreving.bruker[x].person.tidligereetternavn[x].navn"
								}
							]
						},
						"PreviousForenames": {
							"PreviousForename": [
								{
									"previousForename": "$tilbakekreving.bruker[x].person.tidligerefornavn[x].navn"
								}
							]
						},
						"currentFamilyStatus": {
							"value": [
								"$tilbakekreving.bruker[x].person.tilbakekrevingsivilstand.status"
							]
						},
						"dateDeath": "$nav.brukere[x].person.doedsdato"
					}
				}
			]
		},
    "InformationThereAreArrears":{
      "informationThereAreArrearsIndicator":{
        "value": [
          "$tilbakekreving.restskatt.indikator"
        ]
      },
      "FillInFollowingIfInformationThereAreArrears":{
        "entitlementCorrespondingBenefitIndicator":{
          "value": [
            "$tilbakekreving.restskatt.tilsvarende.retttilytelser.indikator"
          ]
        },
        "FillInFollowingIfEntitlementCorresponding":{
          "arrearsHaveAlreadyBeenPaidOutIndicator": "$tilbakekreving.restskatt.utbetalt.indikator",
          "PleaseFillInFollowingIfArrearsHaveAlreadyBeenPaid":{
            "ArrearsDetails":{
              "ArrearsPeriod":{
                "startDate":"$tilbakekreving.restskatt.utbetalt.startdato",
                "endDate":"$tilbakekreving.restskatt.utbetalt.enddato"
              },
              "ArrearsTotalAmount":{
                "amount":"$tilbakekreving.restskatt.beløp",
                "currency": {
                  "value": [
                    "$tilbakekreving.restskatt.valuta"
                  ]
                }
              }
            }
          }
        }
      }
    }
	}
}
