{
	"R005": {
		"sedGVer": "$sedGVer",
		"sedVer": "$sedVer",
		"LocalCaseNumbers": {
			"LocalCaseNumber": [
				{
					"country": {
						"value": [
							"$nav.eessisak[x].land"
						]
					},
					"caseNumber": "$nav.eessisak[x].saksnummer",
					"Institution": {
						"institutionID": "$nav.eessisak[x].institusjonsid",
						"institutionName": "$nav.eessisak[x].institusjonsnavn"
					}
				}
			]
		},
		"Persons": {
			"Person": [
				{
					"PersonIdentification": {
						"familyName": "$nav.brukere[x].person.etternavn",
						"forename": "$nav.brukere[x].person.fornavn",
						"dateBirth": "$nav.brukere[x].person.foedselsdato",
						"sex": {
							"value": [
								"$nav.brukere[x].person.kjoenn"
							]
						},
						"familyNameAtBirth": "$nav.brukere[x].person.etternavnvedfoedsel",
						"forenameAtBirth": "$nav.brukere[x].person.fornavnvedfoedsel",
						"PINPersonInEachInstitution": {
							"PersonalIdentificationNumber": [
								{
									"country": {
										"value": [
											"$nav.brukere[x].person.pin[x].land"
										]
									},
									"personalIdentificationNumber": "$nav.brukere[x].person.pin[x].identifikator",
									"sector": {
										"value": [
											"$nav.brukere[x].person.pin[x].sektor"
										]
									},
									"Institution": {
										"institutionID": "$nav.brukere[x].person.pin[x].institusjonsid",
										"institutionName": "$nav.brukere[x].person.pin[x].institusjonsnavn"
									}
								}
							]
						},
						"IfPINNotProvidedForEveryInstitutionPleaseProvide": {
							"PlaceBirth": {
								"town": "$nav.brukere[x].person.foedested.by",
								"region": "$nav.brukere[x].person.foedested.region",
								"country": {
									"value": [
										"$nav.brukere[x].person.foedested.land"
									]
								}
							},
							"fatherFamilyNameAtBirth": "$nav.brukere[x].far.person.etternavnvedfoedsel",
							"forenameFather": "$nav.brukere[x].far.person.fornavn",
							"motherFamilyNameAtBirth": "$nav.brukere[x].mor.person.etternavnvedfoedsel",
							"forenameMother": "$nav.brukere[x].mor.person.fornavn"
						}
					},
					"AdditionalInformationAboutPerson": {
						"statusPerson": {
							"value": [
								"$nav.brukere[x].tilbakekreving.status.type"
							]
						},
						"PleaseFillInFollowingIfStatusPersonOther": {
							"otherStatusPerson": "$nav.brukere[x].tilbakekreving.status.annen"
						},
						"nationality": {
							"value": [
								"$nav.brukere[x].person.statsborgerskap[x].land"
							]
						},
						"PreviousFamilyNames": {
							"PreviousFamilyName": [
								{
									"previousFamilyName": "$nav.brukere[x].person.tilbakekrevingtidligereetternavn[x].navn"
								}
							]
						},
						"PreviousForenames": {
							"PreviousForename": [
								{
									"previousForename": "$nav.brukere[x].person.tilbakekrevingtidligerefornavn[x].navn"
								}
							]
						},
						"currentFamilyStatus": {
							"value": [
								"$nav.brukere[x].person.sivilstand.status"
							]
						},
						"dateDeath": "$nav.brukere[x].person.doedsdato"
					},
					"PersonLastKnownAddresses": {
						"PersonLastKnownAddressDetails": [
							{
								"typeAddress": {
									"value": [
										"$nav.brukere[x].adresse[x].type"
									]
								},
								"PleaseFillInFollowingIfTypeAddressOther": {
									"specifyOtherType": "$nav.brukere[x].adresse[x].annen"
								},
								"AddressDetail": {
									"street": "$nav.brukere[x].adresse[x].gate",
									"buildingName": "$nav.brukere[x].adresse[x].bygning",
									"town": "$nav.brukere[x].adresse[x].by",
									"postalCode": "$nav.brukere[x].adresse[x].postkode",
									"region": "$nav.brukere[x].adresse[x].region",
									"country": {
										"value": [
											"$nav.brukere[x].adresse[x].land"
										]
									}
								}
							}
						]
					}
				}
			]
		},
		"TypeRequest": {
			"typeRequest": {
				"value": [
					"$tilbakekreving.anmodning.type"
				]
			}
		},
		"TypeBenefitWhichHasBeenOverpaid": {
			"typeBenefitWhichHasBeenOverpaid": {
				"value": [
					"$tilbakekreving.feilutbetaling.ytelse.type"
				]
			}
		},
		"PleaseFillInFollowingIfTypeRequestFinal": {
			"OverpaymentPeriod": {
				"startDate": "$tilbakekreving.feilutbetaling.periode.startdato",
				"endDate": "$tilbakekreving.feilutbetaling.periode.sluttdato"
			},
			"OverpaidTotalAmount": {
				"amount": "$tilbakekreving.feilutbetaling.beloep",
				"currency": {
					"value": [
						"$tilbakekreving.feilutbetaling.valuta"
					]
				}
			},
			"BankDetails": {
				"SEPABankDetails": {
					"IBAN": "$tilbakekreving.anmodningommotregning.bank.konto.sepa.iban",
					"BICSWIFT": "$tilbakekreving.anmodningommotregning.bank.konto.sepa.swift"
				},
				"accountHolderName": "$tilbakekreving.anmodningommotregning.bank.konto.innehaver.navn",
				"paymentReference": "$tilbakekreving.anmodningommotregning.bank.konto.betalingsreferanse",
				"ReceivingBankAddress": {
					"street": "$tilbakekreving.anmodningommotregning.bank.adresse.gate",
					"buildingName": "$tilbakekreving.anmodningommotregning.bank.adresse.bygning",
					"town": "$tilbakekreving.anmodningommotregning.bank.adresse.by",
					"postalCode": "$tilbakekreving.anmodningommotregning.bank.adresse.postkode",
					"region": "$tilbakekreving.anmodningommotregning.bank.adresse.region",
					"country": {
						"value": [
							"$tilbakekreving.anmodningommotregning.bank.adresse.land"
						]
					}
				}
			}
		}
	}
}
