{
	"M040": {
		"sedGVer": "$sedGVer",
		"sedVer": "$sedVer",
		"Claimant": {
			"PersonIdentification": {
				"familyName": "$nav.bruker.person.etternavn",
				"forename": "$nav.bruker.person.fornavn",
				"dateBirth": "$nav.bruker.person.foedselsdato",
				"sex": {
					"value": [
						"$nav.bruker.person.kjoenn"
					]
				},
				"familyNameAtBirth": "$nav.bruker.person.etternavnvedfoedsel",
				"forenameAtBirth": "$nav.bruker.person.fornavnvedfoedsel",
				"PINPersonInEachInstitution": {
					"PersonalIdentificationNumber": [
						{
							"country": {
								"value": [
									"$nav.bruker.person.pin[x].land"
								]
							},
							"personalIdentificationNumber": "$nav.bruker.person.pin[x].identifikator",
							"sector": {
								"value": [
									"$nav.bruker.person.pin[x].sektor"
								]
							},
							"Institution": {
								"institutionID": "$nav.bruker.person.pin[x].institusjonsid",
								"institutionName": "$nav.bruker.person.pin[x].institusjonsnavn"
							}
						}
					]
				},
				"IfPINNotProvidedForEveryInstitutionPleaseProvide": {
					"PlaceBirth": {
						"town": "$nav.bruker.person.foedested.by",
						"region": "$nav.bruker.person.foedested.region",
						"country": {
							"value": [
								"$nav.bruker.person.foedested.land"
							]
						}
					},
					"fatherFamilyNameAtBirth": "$nav.bruker.far.person.etternavnvedfoedsel",
					"forenameFather": "$nav.bruker.far.person.fornavn",
					"motherFamilyNameAtBirth": "$nav.bruker.mor.person.etternavnvedfoedsel",
					"forenameMother": "$nav.bruker.mor.person.fornavn"
				}
			},
			"AdditionalInformationPerson": {
				"nationality": {
					"value": [
						"$nav.bruker.person.statsborgerskap[x].land"
					]
				},
				"PreviousName": {
					"previousFamilyName": "$nav.bruker.person.tidligereetternavn",
					"previousForename": "$nav.bruker.person.tidligerefornavn"
				}
			}
		},
		"PersonEmploymentSelfEmploymentDetails": {
			"StatusActivity": [
				{
					"country": {
						"value": [
							"$diverse.bruker.yrkesaktivitet.status[x].land"
						]
					},
					"personStillPursuing": {
						"value": [
							"$diverse.bruker.yrkesaktivitet.status[x].ennaaktiv.type"
						]
					},
					"PersonCeasedPursue": {
						"personCeasedPursue": {
							"value": [
								"$diverse.bruker.yrkesaktivitet.status[x].ikkelengeraktiv.type"
							]
						},
						"date": "$diverse.bruker.yrkesaktivitet.status[x].ikkelengeraktiv.startdato"
					},
					"PersonReduced": {
						"personReduced": {
							"value": [
								"$diverse.bruker.yrkesaktivitet.status[x].redusertomfang.type"
							]
						},
						"date": "$diverse.bruker.yrkesaktivitet.status[x].redusertomfang.startdato"
					},
					"PersonSuspended": {
						"personSuspended": {
							"value": [
								"$diverse.bruker.yrkesaktivitet.status[x].permisjon.type"
							]
						},
						"date": "$diverse.bruker.yrkesaktivitet.status[x].permisjon.startdato"
					},
					"PersonIntendsRetireFrom": {
						"personIntendsRetireFrom": {
							"value": [
								"$diverse.bruker.yrkesaktivitet.status[x].skalpensjonereseg.type"
							]
						},
						"date": "$diverse.bruker.yrkesaktivitet.status[x].skalpensjonereseg.startdato"
					},
					"PersonIntendsTakeUp": {
						"personIntendsTakeUp": {
							"value": [
								"$diverse.bruker.yrkesaktivitet.status[x].oenskeraaarbeidemed.type"
							]
						},
						"date": "$diverse.bruker.yrkesaktivitet.status[x].oenskeraaarbeidemed.startdato"
					}
				}
			],
			"IfPersonStillPursuingOrIntendsTakeUpEmployment": {
				"amount": "$diverse.bruker.yrkesaktivitet.ennaaktiv.inntekt.maanedligbeloep",
				"currency": {
					"value": [
						"$diverse.bruker.yrkesaktivitet.ennaaktiv.inntekt.valuta"
					]
				}
			},
			"countryLastEmploymentOrSelfEmploymentActivity": {
				"value": [
					"$diverse.bruker.yrkesaktivitet.sisteaktivitet.ansettelsesforhold.land"
				]
			},
			"countryWhichLegislationApplicableDuringLast": {
				"value": [
					"$diverse.bruker.yrkesaktivitet.sisteaktivitet.medlemskap.land"
				]
			},
			"LastEmployerDetails": [
				{
					"name": "$nav.arbeidsgiver[x].navn",
					"IdentificationNumbers": {
						"IdentificationNumber": [
							{
								"number": "$nav.arbeidsgiver[x].identifikator[x].id",
								"type": {
									"value": [
										"$nav.arbeidsgiver[x].identifikator[x].type"
									]
								}
							}
						]
					},
					"Address": {
						"street": "$nav.arbeidsgiver[x].adresse.gate",
						"buildingName": "$nav.arbeidsgiver[x].adresse.bygning",
						"town": "$nav.arbeidsgiver[x].adresse.by",
						"postalCode": "$nav.arbeidsgiver[x].adresse.postnummer",
						"region": "$nav.arbeidsgiver[x].adresse.region",
						"country": {
							"value": [
								"$nav.arbeidsgiver[x].adresse.land"
							]
						}
					}
				}
			],
			"ReasonForTerminationLastEmploymentSelfEmployment": {
				"terminationReasonEmployment": {
					"value": [
						"$diverse.bruker.yrkesaktivitet.avslutningarbeidsforhold.grunn.type"
					]
				},
				"FillInIfTerminationReason": {
					"otherTermination": "$diverse.bruker.yrkesaktivitet.avslutningarbeidsforhold.grunn.annen"
				},
				"terminationReasonSelfEmployment": "$diverse.bruker.yrkesaktivitet.avslutningselvstendignaerignsdrivende.grunn"
			},
			"otherInformationEmploymentOrSelfEmployment": "$diverse.bruker.yrkesaktivitet.ytterligereinformasjon",
			"theDateTerminationLastEmploymentOrSelfEmployment": "$diverse.bruker.yrkesaktivitet.avslutningarbeidsforhold.dato"
		},
		"PersonBenefitDetails": {
			"PersonBenefitDetails": [
				{
					"benefits": {
						"value": [
							"$diverse.ytelser[x].ytelse"
						]
					},
					"PleaseFillInFollowingIfBenefitsOtherBenefit": {
						"otherBenefit": "$diverse.ytelser[x].annenytelse"
					},
					"status": {
						"value": [
							"$diverse.ytelser[x].status"
						]
					},
					"Institution": {
						"institutionID": "$diverse.ytelser[x].institusjon.institusjonsid",
						"institutionName": "$diverse.ytelser[x].institusjon.institusjonsnavn"
					},
					"PeriodBenefitsPayment": {
						"FixedPeriod": {
							"startDate": "$diverse.ytelser[x].fastperiode.startdato",
							"endDate": "$diverse.ytelser[x].fastperiode.sluttdato"
						},
						"OpenPeriod": {
							"typeOpenPeriod": {
								"value": [
									"$diverse.ytelser[x].aapenperiode.type"
								]
							},
							"startDate": "$diverse.ytelser[x].aapenperiode.startdato"
						}
					}
				}
			]
		},
		"InformationRepresentativeLegalGuardian": {
			"status": {
				"value": [
					"$nav.verge.status"
				]
			},
			"InformationRepresentativeLegalGuardian": {
				"name": "$nav.verge.person.navn",
				"Address": {
					"street": "$nav.verge.adresse.gate",
					"buildingName": "$nav.verge.adresse.bygning",
					"town": "$nav.verge.adresse.by",
					"postalCode": "$nav.verge.adresse.postnummer",
					"region": "$nav.verge.adresse.region",
					"country": {
						"value": [
							"$nav.verge.adresse.land"
						]
					}
				}
			}
		},
		"InformationPayment": {
			"paymentTo": {
				"value": [
					"$nav.bruker.bank.konto.innehaver.type"
				]
      },
      "BankDetails": {
        "SEPAAccount": {
          "IBAN": "$nav.bruker.bank.konto.sepa.iban",
          "BICSWIFT": "$nav.bruker.bank.konto.sepa.swift"
        },
        "NonSEPAAccount": {
          "BICSWIFT": "$nav.bruker.bank.konto.ikkesepa.swift",
          "BankAddress": {
            "buildingName": "$nav.bruker.bank.adresse.bygning",
            "country": {
              "value": [
                "$nav.bruker.bank.adresse.land"
              ]
            },
            "town": "$nav.bruker.bank.adresse.by",
            "street": "$nav.bruker.bank.adresse.gate",
            "postalCode": "$nav.bruker.bank.adresse.postkode",
            "region": "$nav.bruker.bank.adresse.region"
          },
          "bankName": "$nav.bruker.bank.navn",
          "accountNumber": "$nav.bruker.bank.kontonummer"
        }
      }
    },
    "Miscellaneous": {
			"dateClaim": "$diverse.krav.dato",
			"remarks": "$diverse.merknader"
		},
		"AdditionalInformation": {
			"additionalInformation": "$nav.ytterligereinformasjon"
		},
		"PleaseFindAttachedFollowingDocument": {
			"attachedDocument": {
				"value": [
					"$diverse.overfoeringinfo.foertidspensjon.dokumentervedlagt.type[x]"
				]
			},
			"otherDocument": "$diverse.overfoeringinfo.foertidspensjon.dokumentervedlagt.annentype"
		}
	}
}
