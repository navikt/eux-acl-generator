              },
              "region" : "$nav.ektefelle.person.foedested.region",
              "town" : "$nav.ektefelle.person.foedested.by"
            },
            "fatherFamilyNameAtBirth" : "$nav.ektefelle.far.person.etternavnvedfoedsel",
            "forenameFather" : "$nav.ektefelle.far.person.fornavn",
            "forenameMother" : "$nav.ektefelle.mor.person.fornavn",
            "motherFamilyNameAtBirth" : "$nav.ektefelle.mor.person.etternavnvedfoedsel"
          },
          "PINPersonInEachInstitution" : {
            "PersonalIdentificationNumber" : [ {
              "Institution" : {
                "institutionID" : "$nav.ektefelle.person.pin[x].institusjonsid",
                "institutionName" : "$nav.ektefelle.person.pin[x].institusjonsnavn"
              },
              "country" : {
                "value" : [ "$nav.ektefelle.person.pin[x].land" ]
              },
              "personalIdentificationNumber" : "$nav.ektefelle.person.pin[x].identifikator",
              "sector" : {
                "value" : [ "$nav.ektefelle.person.pin[x].sektor" ]
              }
            } ]
          },
          "dateBirth" : "$nav.ektefelle.person.foedselsdato",
          "familyName" : "$nav.ektefelle.person.etternavn",
          "familyNameAtBirth" : "$nav.ektefelle.person.etternavnvedfoedsel",
          "forename" : "$nav.ektefelle.person.fornavn",
          "forenameAtBirth" : "$nav.ektefelle.person.fornavnvedfoedsel",
          "sex" : {
            "value" : [ "$nav.ektefelle.person.kjoenn" ]
          }
        }
      }
    },
    "sedGVer" : "$sedGVer",
    "sedVer" : "$sedVer"
  }
