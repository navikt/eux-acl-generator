{
  "R009" : {
    "AdditionalInformation" : {
      "additionalInformation" : "$nav.ytterligereinformasjon"
    },
    "EntitlementBenefits" : {
      "entitlementBenefitsIndicator" : {
        "value" : [ "$tilbakekreving.retttilytelser.harretttilytelser" ]
      },
      "requestHasBeenMadeWithin3MonthsPeriodIndicator" : {
        "value" : [ "$tilbakekreving.retttilytelser.anmodning.erfremsattinnentremaaneder" ]
      }
    },
    "FillInIfEntitlementArrears" : {
      "PleaseFillInFollowingIfDeductionYes" : {
        "TypeBenefitsFromWhichDeductionPossible" : [ {
          "FillInIfInstitutionCompetentFor" : {
            "OtherInstitutionsCompetentForOngoingPayment" : {
              "OtherInstitutionCompetentForOngoingPayment" : [ {
                "institutionID" : "$tilbakekreving.retttilytelser.motregning.ytelse[x].annenkompetentinstitusjon[x].institusjonsid",
                "institutionName" : "$tilbakekreving.retttilytelser.motregning.ytelse[x].annenkompetentinstitusjon[x].institusjonsnavn"
              } ]
            }
          },
          "PeriodicAmount" : {
            "AmountPerUnit" : {
              "amount" : "$tilbakekreving.retttilytelser.motregning.ytelse[x].utbetalingperperiode.beloep",
              "currency" : {
                "value" : [ "$tilbakekreving.retttilytelser.motregning.ytelse[x].utbetalingperperiode.valuta" ]
              }
            },
            "PleaseFillInFollowingIfFrequencyOther" : {
              "otherFrequency" : "$tilbakekreving.retttilytelser.motregning.ytelse[x].hyppighet.annen"
            },
            "frequency" : {
              "value" : [ "$tilbakekreving.retttilytelser.motregning.ytelse[x].hyppighet.type" ]
            },
            "numberPeriodicUnits" : "$tilbakekreving.retttilytelser.motregning.ytelse[x].antallperiodeenheter"
          },
          "TypeBenefitFromWhichDeductionFromOngoing" : {
            "PleaseFillInFollowingIfTypeBenefitOtherBenefit" : {
              "typeOtherBenefit" : "$tilbakekreving.retttilytelser.motregning.ytelse[x].annen"
            },
            "typeBenefit" : {
              "value" : [ "$tilbakekreving.retttilytelser.motregning.ytelse[x].type43" ]
            }
          },
          "institutionCompetentForDeductionFromOngoingPayment" : {
            "value" : [ "$tilbakekreving.retttilytelser.motregning.ytelse[x].institusjon.type[x]" ]
          }
        } ]
      },
      "deductionPossiblePeriodicRatesFromOngoingPaymentsIndicator" : {
        "value" : [ "$tilbakekreving.retttilytelser.harretttilmotregningiloependeutbetalinger" ]
      }
    },
    "FillInIfEntitlementBenefitsYes" : {
      "FillInIfEntitlementArrears" : {
        "ArrearsTotalAmount" : {
          "amount" : "$tilbakekreving.retttilytelser.etterbetaling.beloep",
          "currency" : {
            "value" : [ "$tilbakekreving.retttilytelser.etterbetaling.valuta" ]
          }
        },
        "PayableArrearsPeriod" : {
          "endDate" : "$tilbakekreving.retttilytelser.etterbetaling.periode.sluttdato",
          "startDate" : "$tilbakekreving.retttilytelser.etterbetaling.periode.startdato"
        },
        "amountArrearsCoversFullAmountProvisionalPaymentIndicator" : {
          "value" : [ "$tilbakekreving.retttilytelser.etterbetaling.dekkerhelebeloepet" ]
        }
      },
      "entitlementArrearsACorrespondingBenefitIndicator" : {
        "value" : [ "$tilbakekreving.retttilytelser.harretttiletterbetalingfrasammenlignbareytelser" ]
      }
    },
    "LocalCaseNumbers" : {
      "LocalCaseNumber" : [ {
        "Institution" : {
          "institutionID" : "$nav.eessisak[x].institusjonsid",
          "institutionName" : "$nav.eessisak[x].institusjonsnavn"
        },
        "caseNumber" : "$nav.eessisak[x].saksnummer",
        "country" : {
          "value" : [ "$nav.eessisak[x].land" ]
        }
      } ]
    },
    "Persons" : {
      "Person" : [ {
        "AdditionalInformationAboutPerson" : {
          "PleaseFillInFollowingIfStatusPersonOther" : {
            "otherStatusPerson" : "$nav.brukere[x].tilbakekreving.status.annen"
          },
          "PreviousFamilyNames" : {
            "PreviousFamilyName" : [ {
              "previousFamilyName" : "$tilbakekreving.bruker[x].person.tidligereetternavn[x].navn"
            } ]
          },
          "PreviousForenames" : {
            "PreviousForename" : [ {
              "previousForename" : "$tilbakekreving.bruker[x].person.tidligerefornavn[x].navn"
            } ]
          },
          "currentFamilyStatus" : {
            "value" : [ "$tilbakekreving.bruker[x].person.tilbakekrevingsivilstand.status" ]
          },
          "dateDeath" : "$nav.brukere[x].person.doedsdato",
          "nationality" : {
            "value" : [ "$nav.brukere[x].person.statsborgerskap[x].land" ]
          },
          "statusPerson" : {
            "value" : [ "$nav.brukere[x].tilbakekreving.status.type" ]
          }
        },
        "PersonIdentification" : {
          "IfPINNotProvidedForEveryInstitutionPleaseProvide" : {
            "PlaceBirth" : {
              "country" : {
                "value" : [ "$nav.brukere[x].person.foedested.land" ]
              },
              "region" : "$nav.brukere[x].person.foedested.region",
              "town" : "$nav.brukere[x].person.foedested.by"
            },
            "fatherFamilyNameAtBirth" : "$nav.brukere[x].far.person.etternavnvedfoedsel",
            "forenameFather" : "$nav.brukere[x].far.person.fornavn",
            "forenameMother" : "$nav.brukere[x].mor.person.fornavn",
            "motherFamilyNameAtBirth" : "$nav.brukere[x].mor.person.etternavnvedfoedsel"
          },
          "PINPersonInEachInstitution" : {
            "PersonalIdentificationNumber" : [ {
              "Institution" : {
                "institutionID" : "$nav.brukere[x].person.pin[x].institusjonsid",
                "institutionName" : "$nav.brukere[x].person.pin[x].institusjonsnavn"
              },
              "country" : {
                "value" : [ "$nav.brukere[x].person.pin[x].land" ]
              },
              "personalIdentificationNumber" : "$nav.brukere[x].person.pin[x].identifikator",
              "sector" : {
                "value" : [ "$nav.brukere[x].person.pin[x].sektor" ]
              }
            } ]
          },
          "dateBirth" : "$nav.brukere[x].person.foedselsdato",
          "familyName" : "$nav.brukere[x].person.etternavn",
          "familyNameAtBirth" : "$nav.brukere[x].person.etternavnvedfoedsel",
          "forename" : "$nav.brukere[x].person.fornavn",
          "forenameAtBirth" : "$nav.brukere[x].person.fornavnvedfoedsel",
          "sex" : {
            "value" : [ "$nav.brukere[x].person.kjoenn" ]
          }
        }
      } ]
    },
    "sedGVer" : "$sedGVer",
    "sedVer" : "$sedVer"
  }
}