{
  "R004" : {
    "AdditionalInformation" : {
      "additionalInformation" : "$nav.ytterligereinformasjon"
    },
    "Concerns" : {
      "PleaseFillInWhenCaseConcernsAPerson" : {
        "Persons" : {
          "Person" : [ {
            "AdditionalInformationAboutPerson" : {
              "PleaseFillInFollowingIfStatusPersonOther" : {
                "otherStatusPerson" : "$nav.brukere[x].tilbakekreving.status.annen"
              },
              "PreviousFamilyNames" : {
                "PreviousFamilyName" : [ {
                  "previousFamilyName" : "$tilbakekreving.bruker[x].person.tidligereetternavn[x].navn"
                } ]
              },
              "PreviousForenames" : {
                "PreviousForename" : [ {
                  "previousForename" : "$tilbakekreving.bruker[x].person.tidligerefornavn[x].navn"
                } ]
              },
              "currentFamilyStatus" : {
                "value" : [ "$tilbakekreving.bruker[x].sivilstand.status" ]
              },
              "dateDeath" : "$nav.brukere[x].person.doedsdato",
              "nationality" : {
                "value" : [ "$nav.brukere[x].person.statsborgerskap[x].land" ]
              },
              "statusPerson" : {
                "value" : [ "$nav.brukere[x].tilbakekreving.status.type" ]
              }
            },
            "PersonIdentification" : {
              "IfPINNotProvidedForEveryInstitutionPleaseProvide" : {
                "PlaceBirth" : {
                  "country" : {
                    "value" : [ "$nav.brukere[x].person.foedested.land" ]
                  },
                  "region" : "$nav.brukere[x].person.foedested.region",
                  "town" : "$nav.brukere[x].person.foedested.by"
                },
                "fatherFamilyNameAtBirth" : "$nav.brukere[x].far.person.etternavnvedfoedsel",
                "forenameFather" : "$nav.brukere[x].far.person.fornavn",
                "forenameMother" : "$nav.brukere[x].mor.person.fornavn",
                "motherFamilyNameAtBirth" : "$nav.brukere[x].mor.person.etternavnvedfoedsel"
              },
              "PINPersonInEachInstitution" : {
                "PersonalIdentificationNumber" : [ {
                  "Institution" : {
                    "institutionID" : "$nav.brukere[x].person.pin[x].institusjonsid",
                    "institutionName" : "$nav.brukere[x].person.pin[x].institusjonsnavn"
                  },
                  "country" : {
                    "value" : [ "$nav.brukere[x].person.pin[x].land" ]
                  },
                  "personalIdentificationNumber" : "$nav.brukere[x].person.pin[x].identifikator",
                  "sector" : {
                    "value" : [ "$nav.brukere[x].person.pin[x].sektor" ]
                  }
                } ]
              },
              "dateBirth" : "$nav.brukere[x].person.foedselsdato",
              "familyName" : "$nav.brukere[x].person.etternavn",
              "familyNameAtBirth" : "$nav.brukere[x].person.etternavnvedfoedsel",
              "forename" : "$nav.brukere[x].person.fornavn",
              "forenameAtBirth" : "$nav.brukere[x].person.fornavnvedfoedsel",
              "sex" : {
                "value" : [ "$nav.brukere[x].person.kjoenn" ]
              }
            }
          } ]
        }
      },
      "PleaseFillInWhenCaseConcernsAnEmployer" : {
        "Employer" : {
          "Address" : {
            "buildingName" : "$nav.arbeidsgiver.adresse.bygning",
            "country" : {
              "value" : [ "$nav.arbeidsgiver.adresse.land" ]
            },
            "postalCode" : "$nav.arbeidsgiver.adresse.postnummer",
            "region" : "$nav.arbeidsgiver.adresse.region",
            "street" : "$nav.arbeidsgiver.adresse.gate",
            "town" : "$nav.arbeidsgiver.adresse.by"
          },
          "IdentificationNumbers" : {
            "IdentificationNumber" : [ {
              "number" : "$nav.arbeidsgiver.identifikator[x].id",
              "type" : {
                "value" : [ "$nav.arbeidsgiver.identifikator[x].type" ]
              }
            } ]
          },
          "name" : "$nav.arbeidsgiver.navn"
        },
        "Persons" : {
          "Person" : [ {
            "AdditionalInformationAboutPerson" : {
              "PleaseFillInFollowingIfStatusPersonOther" : {
                "otherStatusPerson" : "$tilbakekreving.ansatt[x].status.annen"
              },
              "PreviousFamilyNames" : {
                "PreviousFamilyName" : [ {
                  "previousFamilyName" : "$tilbakekreving.ansatt[x].person.tidligereetternavn[x].navn"
                } ]
              },
              "PreviousForenames" : {
                "PreviousForename" : [ {
                  "previousForename" : "$tilbakekreving.ansatt[x].person.tidligerefornavn[x].navn"
                } ]
              },
              "currentFamilyStatus" : {
                "value" : [ "$tilbakekreving.ansatt[x].person.sivilstand.status" ]
              },
              "dateDeath" : "$tilbakekreving.ansatt[x].person.doedsdato",
              "nationality" : {
                "value" : [ "$tilbakekreving.ansatt[x].person.statsborgerskap[x].land" ]
              },
              "statusPerson" : {
                "value" : [ "$tilbakekreving.ansatt[x].status.type" ]
              }
            },
            "PersonIdentification" : {
              "IfPINNotProvidedForEveryInstitutionPleaseProvide" : {
                "PlaceBirth" : {
                  "country" : {
                    "value" : [ "$tilbakekreving.ansatt[x].person.foedested.land" ]
                  },
                  "region" : "$tilbakekreving.ansatt[x].person.foedested.region",
                  "town" : "$tilbakekreving.ansatt[x].person.foedested.by"
                },
                "fatherFamilyNameAtBirth" : "$tilbakekreving.ansatt[x].far.person.etternavnvedfoedsel",
                "forenameFather" : "$tilbakekreving.ansatt[x].far.person.fornavn",
                "forenameMother" : "$tilbakekreving.ansatt[x].mor.person.fornavn",
                "motherFamilyNameAtBirth" : "$tilbakekreving.ansatt[x].mor.person.etternavnvedfoedsel"
              },
              "PINPersonInEachInstitution" : {
                "PersonalIdentificationNumber" : [ {
                  "Institution" : {
                    "institutionID" : "$tilbakekreving.ansatt[x].person.pin[x].institusjonsid",
                    "institutionName" : "$tilbakekreving.ansatt[x].person.pin[x].institusjonsnavn"
                  },
                  "country" : {
                    "value" : [ "$tilbakekreving.ansatt[x].person.pin[x].land" ]
                  },
                  "personalIdentificationNumber" : "$tilbakekreving.ansatt[x].person.pin[x].identifikator",
                  "sector" : {
                    "value" : [ "$tilbakekreving.ansatt[x].person.pin[x].sektor" ]
                  }
                } ]
              },
              "dateBirth" : "$tilbakekreving.ansatt[x].person.foedselsdato",
              "familyName" : "$tilbakekreving.ansatt[x].person.etternavn",
              "familyNameAtBirth" : "$tilbakekreving.ansatt[x].person.etternavnvedfoedsel",
              "forename" : "$tilbakekreving.ansatt[x].person.fornavn",
              "forenameAtBirth" : "$tilbakekreving.ansatt[x].person.fornavnvedfoedsel",
              "sex" : {
                "value" : [ "$tilbakekreving.ansatt[x].person.kjoenn" ]
              }
            }
          } ]
        },
        "ResponsiblePersonOrSection" : {
          "ContactInformation" : {
            "EmailAddresses" : {
              "EmailAddress" : [ {
                "email" : "$nav.arbeidsgiver.kontakt.email[x].adresse"
              } ]
            },
            "TelephoneNumbers" : {
              "TelephoneNumber" : [ {
                "number" : "$nav.arbeidsgiver.kontakt.telefon[x].nummer",
                "type" : {
                  "value" : [ "$nav.arbeidsgiver.kontakt.telefon[x].type" ]
                }
              } ]
            }
          },
          "responsiblePersonOrSection" : "$nav.arbeidsgiver.ansvarligpersonellerenhet"
        }
      }
    },
    "LocalCaseNumbers" : {
      "LocalCaseNumber" : [ {
        "Institution" : {
          "institutionID" : "$nav.eessisak[x].institusjonsid",
          "institutionName" : "$nav.eessisak[x].institusjonsnavn"
        },
        "caseNumber" : "$nav.eessisak[x].saksnummer",
        "country" : {
          "value" : [ "$nav.eessisak[x].land" ]
        }
      } ]
    },
    "Payments" : {
      "Payment" : [ {
        "PaymentDetails" : {
          "Amount" : {
            "amount" : "$tilbakekreving.utbetaling[x].beloep",
            "currency" : {
              "value" : [ "$tilbakekreving.utbetaling[x].valuta" ]
            }
          },
          "paymentDate" : "$tilbakekreving.utbetaling[x].dato",
          "typePayment" : {
            "value" : [ "$tilbakekreving.utbetaling[x].type" ]
          }
        },
        "paymentReferenceUsedWhenTransferringMoney" : "$tilbakekreving.utbetaling[x].referanse",
        "reasonForPayment" : {
          "value" : [ "$tilbakekreving.utbetaling[x].grunn.type" ]
        }
      } ]
    },
    "sedGVer" : "$sedGVer",
    "sedVer" : "$sedVer"
  }
}