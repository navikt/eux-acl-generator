{
  "H005" : {
    "AdditionalInformation" : {
      "additionalInformation" : "$nav.ytterligereinformasjon"
    },
    "ElementsDetermineResidence" : {
      "Addresses" : [ {
        "Address" : {
          "buildingName" : "$horisontal.anmodningominformasjon.fastslaabosted.bruker.adresse[x].bygning",
          "country" : {
            "value" : [ "$horisontal.anmodningominformasjon.fastslaabosted.bruker.adresse[x].land" ]
          },
          "postalCode" : "$horisontal.anmodningominformasjon.fastslaabosted.bruker.adresse[x].postnummer",
          "region" : "$horisontal.anmodningominformasjon.fastslaabosted.bruker.adresse[x].region",
          "street" : "$horisontal.anmodningominformasjon.fastslaabosted.bruker.adresse[x].gate",
          "town" : "$horisontal.anmodningominformasjon.fastslaabosted.bruker.adresse[x].by"
        },
        "continuityPresence" : "$horisontal.anmodningominformasjon.fastslaabosted.varighetuavbruttopphold",
        "durationPresence" : "$horisontal.anmodningominformasjon.fastslaabosted.oppholdetsvarighet",
        "typeAddress" : {
          "value" : [ "$horisontal.anmodningominformasjon.fastslaabosted.bruker.adresse[x].type" ]
        }
      } ],
      "DescriptionNatureSpecificCharacteristicsActivity" : [ {
        "descriptionActivity" : "$horisontal.anmodningominformasjon.aktivitet.beskrivelse",
        "durationActivity" : "$horisontal.anmodningominformasjon.aktivitet.varighet",
        "locationActivity" : "$horisontal.anmodningominformasjon.aktivitet.sted",
        "natureActivity" : "$horisontal.anmodningominformasjon.aktivitet.art",
        "typeActivity" : {
          "value" : [ "$horisontal.anmodningominformasjon.aktivitet.type" ]
        }
      } ],
      "FamilyStatus" : {
        "familyMemberChildren" : "$horisontal.anmodningominformasjon.familiestatus.barn.familiemedlem",
        "familyMemberSpouse" : "$horisontal.anmodningominformasjon.familiestatus.ektefelle.familiemedlem",
        "placeResidenceChildren" : "$horisontal.anmodningominformasjon.familiestatus.barn.bosted",
        "placeResidenceSpouse" : "$horisontal.anmodningominformasjon.familiestatus.ektefelle.bosted",
        "placeSchoolChildren" : "$horisontal.anmodningominformasjon.familiestatus.barn.skolekrets"
      },
      "PleaseFillInIfStatusPersonOther" : {
        "other" : "$horisontal.anmodningominformasjon.aktivitet.status.annet"
      },
      "housingSituationInParticularHowPermanentItIs" : "$horisontal.anmodningominformasjon.fastslaabosted.bruker.hvorpermanent",
      "intentionPersonConcernedReasonsMove" : "$horisontal.anmodningominformasjon.fastslaabosted.bruker.grunnforflytting",
      "residenceForTaxPurposes" : "$horisontal.anmodningominformasjon.fastslaabosted.bruker.permanentoppholdskattemessig",
      "sourceIncomeStudents" : "$horisontal.anmodningominformasjon.inntektskilde.studenter",
      "statusPerson" : {
        "value" : [ "$horisontal.anmodningominformasjon.aktivitet.status.id" ]
      }
    },
    "Person" : {
      "AdditionalInformationPerson" : {
        "nationality" : {
          "value" : [ "$nav.bruker.person.statsborgerskap[x].land" ]
        }
      },
      "PersonIdentification" : {
        "IfPINNotProvidedForEveryInstitutionPleaseProvide" : {
          "PlaceBirth" : {
            "country" : {
              "value" : [ "$nav.bruker.person.foedested.land" ]
            },
            "region" : "$nav.bruker.person.foedested.region",
            "town" : "$nav.bruker.person.foedested.by"
          },
          "fatherFamilyNameAtBirth" : "$nav.bruker.far.person.etternavnvedfoedsel",
          "forenameFather" : "$nav.bruker.far.person.fornavn",
          "forenameMother" : "$nav.bruker.mor.person.fornavn",
          "motherFamilyNameAtBirth" : "$nav.bruker.mor.person.etternavnvedfoedsel"
        },
        "PINPersonInEachInstitution" : {
          "PersonalIdentificationNumber" : [ {
            "Institution" : {
              "institutionID" : "$nav.bruker.person.pin[x].institusjonsid",
              "institutionName" : "$nav.bruker.person.pin[x].institusjonsnavn"
            },
            "country" : {
              "value" : [ "$nav.bruker.person.pin[x].land" ]
            },
            "personalIdentificationNumber" : "$nav.bruker.person.pin[x].identifikator",
            "sector" : {
              "value" : [ "$nav.bruker.person.pin[x].sektor" ]
            }
          } ]
        },
        "dateBirth" : "$nav.bruker.person.foedselsdato",
        "familyName" : "$nav.bruker.person.etternavn",
        "familyNameAtBirth" : "$nav.bruker.person.etternavnvedfoedsel",
        "forename" : "$nav.bruker.person.fornavn",
        "forenameAtBirth" : "$nav.bruker.person.fornavnvedfoedsel",
        "sex" : {
          "value" : [ "$nav.bruker.person.kjoenn" ]
        }
      }
    },
    "RequestForInformation" : {
      "detailsRequest" : "$horisontal.anmodningominformasjon.detaljer"
    },
    "sedGVer" : "$sedGVer",
    "sedVer" : "$sedVer"
  }
}