{
  "F026": {
    "sedGVer": "$sedGVer",
    "sedVer": "$sedVer",
    "Person": {
      "PersonIdentification": {
        "familyName": "$nav.bruker.person.etternavn",
        "forename": "$nav.bruker.person.fornavn",
        "dateBirth": "$nav.bruker.person.foedselsdato",
        "sex": {
          "value": [
            "$nav.bruker.person.kjoenn"
          ]
        },
        "familyNameAtBirth": "$nav.bruker.person.etternavnvedfoedsel",
        "forenameAtBirth": "$nav.bruker.person.fornavnvedfoedsel",
        "PINPersonInEachInstitution": {
          "PersonalIdentificationNumber": [
            {
              "country": {
                "value": [
                  "$nav.bruker.person.pin[x].land"
                ]
              },
              "personalIdentificationNumber": "$nav.bruker.person.pin[x].identifikator",
              "sector": {
                "value": [
                  "$nav.bruker.person.pin[x].sektor"
                ]
              },
              "Institution": {
                "institutionID": "$nav.bruker.person.pin[x].institusjonsid",
                "institutionName": "$nav.bruker.person.pin[x].institusjonsnavn"
              }
            }
          ]
        },
        "IfPINNotProvidedForEveryInstitutionPleaseProvide": {
          "PlaceBirth": {
            "town": "$nav.bruker.person.foedested.by",
            "region": "$nav.bruker.person.foedested.region",
            "country": {
              "value": [
                "$nav.bruker.person.foedested.land"
              ]
            }
          },
          "fatherFamilyNameAtBirth": "$nav.bruker.far.person.etternavnvedfoedsel",
          "forenameFather": "$nav.bruker.far.person.fornavn",
          "motherFamilyNameAtBirth": "$nav.bruker.mor.person.etternavnvedfoedsel",
          "forenameMother": "$nav.bruker.mor.person.fornavn"
        }
      },
      "AdditionalInformationAboutNationality": {
        "Nationalities": [
          {
            "nationality": {
              "value": [
                "$nav.bruker.person.statsborgerskap[x].land"
              ]
            },
            "since": "$nav.bruker.person.statsborgerskap[x].siden"
          }
        ]
      },
      "AddressesPerson": {
        "AddressPerson": [
          {
            "typeAddress": {
              "value": [
                "$nav.bruker.adresse[x].type"
              ]
            },
            "Address": {
              "street": "$nav.bruker.adresse[x].gate",
              "buildingName": "$nav.bruker.adresse[x].bygning",
              "town": "$nav.bruker.adresse[x].by",
              "postalCode": "$nav.bruker.adresse[x].postnummer",
              "region": "$nav.bruker.adresse[x].region",
              "country": {
                "value": [
                  "$nav.bruker.adresse[x].land"
                ]
              }
            }
          }
        ]
      },
      "ContactDetails": {
        "TelephoneNumbers": {
          "TelephoneNumber": [
            {
              "type": {
                "value": [
                  "$nav.bruker.person.kontakt.telefon[x].type"
                ]
              },
              "number": "$nav.bruker.person.kontakt.telefon[x].nummer"
            }
          ]
        },
        "EmailAddresses": {
          "EmailAddress": [
            {
              "email": "$nav.bruker.person.kontakt.email[x].adresse"
            }
          ]
        }
      },
      "CoverageBySocialSecurityScheme": {
        "PeriodsCoveredBySecuritySchemeInSendingMember": {
          "Period": [
            {
              "startDate": "$familie.bruker.dekketavtrygd.periode[x].startdato",
              "endDate": "$familie.bruker.dekketavtrygd.periode[x].sluttdato"
            }
          ]
        },
        "PeriodsNotCovered": {
          "PeriodNotCovered": [
            {
              "startDate": "$familie.bruker.ikkedekketavtrygd.periode[x].startdato",
              "endDate": "$familie.bruker.ikkedekketavtrygd.periode[x].sluttdato"
            }
          ]
        },
        "PeriodsEntitlement": {
          "EntitlementFamilyBenefitsExists": {
            "PeriodEntitlementFamilyBenefits": {
              "PeriodEntitlementFamilyBenefit": [
                {
                  "startDate": "$familie.bruker.retttilytelser.periode[x].startdato",
                  "endDate": "$familie.bruker.retttilytelser.periode[x].sluttdato"
                }
              ]
            }
          },
          "EntitlementFamilyBenefitsDoesNotExist": {
            "reason": {
              "value": [
                "$familie.bruker.ikkeretttilytelser.grunn.type"
              ]
            },
            "otherReason": "$familie.bruker.ikkeretttilytelser.grunn.annen"
          }
        }
      }
    },
    "InCaseAdoption": {
      "requestedInformation": {
        "value": [
          "$familie.anmodningommerinformasjon.adopsjon.etterspurtinformasjon.type"
        ]
      },
      "additionalRequestInformation": "$familie.anmodningommerinformasjon.adopsjon.ytterligereinformasjon"
    },
    "Income": {
      "requestedInformation": {
        "value": [
          "$familie.anmodningommerinformasjon.inntekt.etterspurtinformasjon.type[x]"
        ]
      },
      "additionalRequestInformation": "$familie.anmodningommerinformasjon.inntekt.ytterligereinformasjon"
    },
    "OrphansBenefits": {
      "requestedInformation": {
        "value": [
          "$familie.anmodningommerinformasjon.ytelsetilforeldreloese.etterspurtinformasjon.type[x]"
        ]
      },
      "additionalRequestInformation": "$familie.anmodningommerinformasjon.ytelsetilforeldreloese.ytterligereinformasjon"
    },
    "OtherInformationRelatedChild": {
      "requestedInformation": {
        "value": [
          "$familie.anmodningommerinformasjon.anneninformasjonbarnet.etterspurtinformasjon.type[x]"
        ]
      },
      "additionalRequestInformation": "$familie.anmodningommerinformasjon.anneninformasjonbarnet.ytterligereinformasjon"
    },
    "SchoolUniversityEstablishmentHigherEducation": {
      "Organisation": {
        "name": "$familie.anmodningommerinformasjon.utdanningsinstitusjon.navn",
        "IdentificationNumbers": {
          "IdentificationNumber": [
            {
              "number": "$familie.anmodningommerinformasjon.utdanningsinstitusjon.identifikator[x].id",
              "type": {
                "value": [
                  "$familie.anmodningommerinformasjon.utdanningsinstitusjon.identifikator[x].type"
                ]
              }
            }
          ]
        },
        "Address": {
          "street": "$familie.anmodningommerinformasjon.utdanningsinstitusjon.adresse.gate",
          "buildingName": "$familie.anmodningommerinformasjon.utdanningsinstitusjon.adresse.bygning",
          "town": "$familie.anmodningommerinformasjon.utdanningsinstitusjon.adresse.by",
          "postalCode": "$familie.anmodningommerinformasjon.utdanningsinstitusjon.adresse.postnummer",
          "region": "$familie.anmodningommerinformasjon.utdanningsinstitusjon.adresse.region",
          "country": {
            "value": [
              "$familie.anmodningommerinformasjon.utdanningsinstitusjon.adresse.land"
            ]
          }
        }
      },
      "additionalRequestInformation": "$familie.anmodningommerinformasjon.utdanningsinstitusjon.ytterligereinformasjon"
    },
    "AttendanceAtSchoolCollegeTrainingUnemployed": {
      "isTheChildAttending": {
        "value": [
          "$familie.anmodningommerinformasjon.utdanning.type"
        ]
      },
      "SpecifyIfAttendanceIs": {
        "partTime": "$familie.anmodningommerinformasjon.utdanning.gjelderdeltid",
        "fullTime": "$familie.anmodningommerinformasjon.utdanning.gjelderheltid",
        "actualAttendance": "$familie.anmodningommerinformasjon.utdanning.faktiskdeltakelse",
        "additionalRequestInformation": "$familie.anmodningommerinformasjon.utdanning.ytterligereinformasjon"
      }
    },
    "AdditionalInformation": {
      "additionalInformation": "$nav.ytterligereinformasjon"
    }
  }
}