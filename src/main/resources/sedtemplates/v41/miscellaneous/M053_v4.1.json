{
  "M053": {
    "sedGVer": "$sedGVer",
    "sedVer": "$sedVer",
    "Person": {
      "PersonIdentification": {
        "familyName": "$nav.bruker.person.etternavn",
        "forename": "$nav.bruker.person.fornavn",
        "dateBirth": "$nav.bruker.person.foedselsdato",
        "sex": {
          "value": [
            "$nav.bruker.person.kjoenn"
          ]
        },
        "familyNameAtBirth": "$nav.bruker.person.etternavnvedfoedsel",
        "forenameAtBirth": "$nav.bruker.person.fornavnvedfoedsel",
        "PINPersonInEachInstitution": {
          "PersonalIdentificationNumber": [
            {
              "country": {
                "value": [
                  "$nav.bruker.person.pin[x].land"
                ]
              },
              "personalIdentificationNumber": "$nav.bruker.person.pin[x].identifikator",
              "sector": {
                "value": [
                  "$nav.bruker.person.pin[x].sektor"
                ]
              },
              "Institution": {
                "institutionID": "$nav.bruker.person.pin[x].institusjonsid",
                "institutionName": "$nav.bruker.person.pin[x].institusjonsnavn"
              }
            }
          ]
        },
        "IfPINNotProvidedForEveryInstitutionPleaseProvide": {
          "PlaceBirth": {
            "town": "$nav.bruker.person.foedested.by",
            "region": "$nav.bruker.person.foedested.region",
            "country": {
              "value": [
                "$nav.bruker.person.foedested.land"
              ]
            }
          },
          "fatherFamilyNameAtBirth": "$nav.bruker.far.person.etternavnvedfoedsel",
          "forenameFather": "$nav.bruker.far.person.fornavn",
          "motherFamilyNameAtBirth": "$nav.bruker.mor.person.etternavnvedfoedsel",
          "forenameMother": "$nav.bruker.mor.person.fornavn"
        }
      },
      "AdditionalInformationPerson": {
        "nationality": {
          "value": [
            "$nav.bruker.person.statsborgerskap[x].land"
          ]
        },
        "statusPerson": {
          "value": [
            "$diverse.bruker.status.id"
          ]
        },
        "PleaseFillInFollowingIfStatusPersonOther": {
          "otherStatus": "$diverse.bruker.status.annet"
        },
        "AddressPerson": {
          "typeAddress": {
            "value": [
              "$nav.bruker.bostedsadresse.type"
            ]
          },
          "Address": {
            "street": "$nav.bruker.bostedsadresse.gate",
            "buildingName": "$nav.bruker.bostedsadresse.bygning",
            "town": "$nav.bruker.bostedsadresse.by",
            "postalCode": "$nav.bruker.bostedsadresse.postnummer",
            "region": "$nav.bruker.bostedsadresse.region",
            "country": {
              "value": [
                "$nav.bruker.bostedsadresse.land"
              ]
            }
          }
        },
        "pursuesAProfessionalOrTradeActivityIndicator": {
          "value": [
            "$diverse.bruker.utoeverprofesjon"
          ]
        }
      }
    },
    "PersonNamedInSpecificSection": {
      "PeriodsEmployment": [
        {
          "startDate": "$nav.bruker.aktivitet.ansettelse.periode[x].startdato",
          "endDate": "$nav.bruker.aktivitet.ansettelse.periode[x].sluttdato"
        }
      ],
      "PeriodsSelfEmployment": [
        {
          "startDate": "$nav.bruker.aktivitet.selvstendig.periode[x].startdato",
          "endDate": "$nav.bruker.aktivitet.selvstendig.periode[x].sluttdato"
        }
      ],
      "PeriodsResidenceInCountrySendingInstitution": [
        {
          "Period": {
            "startDate": "$nav.bruker.bosted.avsenderland[x].periode.startdato",
            "endDate": "$nav.bruker.bosted.avsenderland[x].periode.sluttdato"
          },
          "Address": {
            "street": "$nav.bruker.bosted.avsenderland[x].adresse.gate",
            "buildingName": "$nav.bruker.bosted.avsenderland[x].adresse.bygning",
            "town": "$nav.bruker.bosted.avsenderland[x].adresse.by",
            "postalCode": "$nav.bruker.bosted.avsenderland[x].adresse.postnummer",
            "region": "$nav.bruker.bosted.avsenderland[x].adresse.region",
            "country": {
              "value": [
                "$nav.bruker.bosted.avsenderland[x].adresse.land"
              ]
            }
          }
        }
      ]
    },
    "AdditionalInformation": {
      "additionalInformation": "$nav.ytterligereinformasjon"
    },
    "PleaseFindAttachedFollowingDocument": {
      "attachedDocument": {
        "value": [
          "$diverse.overfoeringinfo.dokumentervedlagt.type[x]"
        ]
      },
      "otherDocument": "$diverse.overfoeringinfo.dokumentervedlagt.annentype"
    }
  }
}
