{
	"DA061": {
		"sedGVer": "$sedGVer",
		"sedVer": "$sedVer",
		"Person": {
			"PersonIdentification": {
				"familyName": "$nav.bruker.person.etternavn",
				"forename": "$nav.bruker.person.fornavn",
				"dateBirth": "$nav.bruker.person.foedselsdato",
				"sex": {
					"value": [
						"$nav.bruker.person.kjoenn"
					]
				},
				"familyNameAtBirth": "$nav.bruker.person.etternavnvedfoedsel",
				"forenameAtBirth": "$nav.bruker.person.fornavnvedfoedsel",
				"PINPersonInEachInstitution": {
					"PersonalIdentificationNumber": [
						{
							"country": {
								"value": [
									"$nav.bruker.person.pin[x].land"
								]
							},
							"personalIdentificationNumber": "$nav.bruker.person.pin[x].identifikator",
							"sector": {
								"value": [
									"$nav.bruker.person.pin[x].sektor"
								]
							},
							"Institution": {
								"institutionID": "$nav.bruker.person.pin[x].institusjonsid",
								"institutionName": "$nav.bruker.person.pin[x].institusjonsnavn"
							}
						}
					]
				},
				"IfPINNotProvidedForEveryInstitutionPleaseProvide": {
					"PlaceBirth": {
						"town": "$nav.bruker.person.foedested.by",
						"region": "$nav.bruker.person.foedested.region",
						"country": {
							"value": [
								"$nav.bruker.person.foedested.land"
							]
						}
					},
					"fatherFamilyNameAtBirth": "$nav.bruker.far.person.etternavnvedfoedsel",
					"forenameFather": "$nav.bruker.far.person.fornavn",
					"motherFamilyNameAtBirth": "$nav.bruker.mor.person.etternavnvedfoedsel",
					"forenameMother": "$nav.bruker.mor.person.fornavn"
				}
			},
			"AdditionalInformationPerson": {
				"nationality": {
					"value": [
						"$nav.bruker.person.statsborgerskap[x].land"
					]
				},
				"PreviousName": {
					"previousFamilyName": "$nav.bruker.person.tidligereetternavn",
					"previousForename": "$nav.bruker.person.tidligerefornavn"
				}
			}
		},
		"Institution": {
			"countryCode": {
				"value": [
					"$arbeidsulykkeyrkessykdom.videresending.kravompensjon.institusjon.land"
				]
			},
			"Institution": {
				"institutionID": "$arbeidsulykkeyrkessykdom.videresending.kravompensjon.institusjon.institusjonsid",
				"institutionName": "$arbeidsulykkeyrkessykdom.videresending.kravompensjon.institusjon.institusjonsnavn"
			}
		},
		"AddressesPerson": {
			"AddressPerson": [
				{
					"typeAddress": {
						"value": [
							"$nav.bruker.adresse[x].type[x]"
						]
					},
					"Address": {
						"street": "$nav.bruker.adresse[x].gate",
						"buildingName": "$nav.bruker.adresse[x].bygning",
						"town": "$nav.bruker.adresse[x].by",
						"postalCode": "$nav.bruker.adresse[x].postnummer",
						"region": "$nav.bruker.adresse[x].region",
						"country": {
							"value": [
								"$nav.bruker.adresse[x].land"
							]
						}
					}
				}
			]
		},
		"DateSubmissionClaim": {
			"date": "$arbeidsulykkeyrkessykdom.videresending.kravompensjon.krav.dato"
		},
		"SurvivorsSubmittingClaim": {
			"SurvivorSubmittingClaim": [
				{
					"PersonIdentification": {
						"familyName": "$nav.gjenlevende[x].person.etternavn",
						"forename": "$nav.gjenlevende[x].person.fornavn",
						"dateBirth": "$nav.gjenlevende[x].person.foedselsdato",
						"sex": {
							"value": [
								"$nav.gjenlevende[x].person.kjoenn"
							]
						},
						"familyNameAtBirth": "$nav.gjenlevende[x].person.etternavnvedfoedsel",
						"forenameAtBirth": "$nav.gjenlevende[x].person.fornavnvedfoedsel",
						"PINPersonInEachInstitution": {
							"PersonalIdentificationNumber": [
								{
									"country": {
										"value": [
											"$nav.gjenlevende[x].person.pin[x].land"
										]
									},
									"personalIdentificationNumber": "$nav.gjenlevende[x].person.pin[x].identifikator",
									"sector": {
										"value": [
											"$nav.gjenlevende[x].person.pin[x].sektor"
										]
									},
									"Institution": {
										"institutionID": "$nav.gjenlevende[x].person.pin[x].institusjonsid",
										"institutionName": "$nav.gjenlevende[x].person.pin[x].institusjonsnavn"
									}
								}
							]
						},
						"IfPINNotProvidedForEveryInstitutionPleaseProvide": {
							"PlaceBirth": {
								"town": "$nav.gjenlevende[x].person.foedested.by",
								"region": "$nav.gjenlevende[x].person.foedested.region",
								"country": {
									"value": [
										"$nav.gjenlevende[x].person.foedested.land"
									]
								}
							},
							"fatherFamilyNameAtBirth": "$nav.gjenlevende[x].far.person.etternavnvedfoedsel",
							"forenameFather": "$nav.gjenlevende[x].far.person.fornavn",
							"motherFamilyNameAtBirth": "$nav.gjenlevende[x].mor.person.etternavnvedfoedsel",
							"forenameMother": "$nav.gjenlevende[x].mor.person.fornavn"
						}
					},
					"AdditionalInformationOnPerson": {
						"nationality": {
							"value": [
								"$nav.gjenlevende[x].person.statsborgerskap.land"
							]
						},
						"AddressesSurvivor": [
							{
								"AddressPerson": [
									{
										"typeAddress": {
											"value": [
												"$nav.gjenlevende[x].gjenlevendeadresse[x].adresse[x].type"
											]
										},
										"Address": {
											"street": "$nav.gjenlevende[x].gjenlevendeadresse[x].adresse[x].gate",
											"buildingName": "$nav.gjenlevende[x].gjenlevendeadresse[x].adresse[x].bygning",
											"town": "$nav.gjenlevende[x].gjenlevendeadresse[x].adresse[x].by",
											"postalCode": "$nav.gjenlevende[x].gjenlevendeadresse[x].adresse[x].postnummer",
											"region": "$nav.gjenlevende[x].gjenlevendeadresse[x].adresse[x].region",
											"country": {
												"value": [
													"$nav.gjenlevende[x].gjenlevendeadresse[x].adresse[x].land"
												]
											}
										}
									}
								]
							}
						]
					}
				}
			]
		},
		"AdditionalInformation": {
			"additionalInformation": "$nav.ytterligereinformasjon"
		}
	}
}
