{
  "P14000": {
    "LocalCaseNumbers": {
      "LocalCaseNumber": [
        {
          "country": {
            "value": [
              "$nav.eessisak[x].land"
            ]
          },
          "caseNumber": "$nav.eessisak[x].saksnummer",
          "Institution": {
            "institutionID": "$nav.eessisak[x].institusjonsid",
            "institutionName": "$nav.eessisak[x].institusjonsnavn"
          }
        }
      ]
    },
    "sedGVer": "$sedGVer",
    "sedVer": "$sedVer",
    "Person": {
      "AdditionalInformationPerson": {
        "Address": {
          "buildingName": "$nav.bruker.adresse.bygning",
          "country": {
            "value": [
              "$nav.bruker.adresse.land"
            ]
          },
          "town": "$nav.bruker.adresse.by",
          "street": "$nav.bruker.adresse.gate",
          "postalCode": "$nav.bruker.adresse.postnummer",
          "region": "$nav.bruker.adresse.region"
        },
        "AdditionalInformationPerson": {
          "previousFamilyName": "$nav.bruker.person.tidligereetternavn",
          "nationality": {
            "value": [
              "$nav.bruker.person.statsborgerskap[x].land"
            ]
          },
          "previousForename": "$nav.bruker.person.tidligerefornavn"
        }
      },
      "PersonIdentification": {
        "forename": "$nav.bruker.person.fornavn",
        "familyNameAtBirth": "$nav.bruker.person.etternavnvedfoedsel",
        "forenameAtBirth": "$nav.bruker.person.fornavnvedfoedsel",
        "familyName": "$nav.bruker.person.etternavn",
        "sex": {
          "value": [
            "$nav.bruker.person.kjoenn"
          ]
        },
        "PINPersonInEachInstitution": {
          "PersonalIdentificationNumber": [
            {
              "country": {
                "value": [
                  "$nav.bruker.person.pin[x].land"
                ]
              },
              "personalIdentificationNumber": "$nav.bruker.person.pin[x].identifikator",
              "Institution": {
                "institutionID": "$nav.bruker.person.pin[x].institusjonsid",
                "institutionName": "$nav.bruker.person.pin[x].institusjonsnavn"
              },
              "sector": {
                "value": [
                  "$nav.bruker.person.pin[x].sektor"
                ]
              }
            }
          ]
        },
        "IfPINNotProvidedForEveryInstitutionPleaseProvide": {
          "PlaceBirth": {
            "country": {
              "value": [
                "$nav.bruker.person.foedested.land"
              ]
            },
            "town": "$nav.bruker.person.foedested.by",
            "region": "$nav.bruker.person.foedested.region"
          },
          "motherFamilyNameAtBirth": "$nav.bruker.mor.person.etternavnvedfoedsel",
          "forenameMother": "$nav.bruker.mor.person.fornavn",
          "forenameFather": "$nav.bruker.far.person.fornavn",
          "fatherFamilyNameAtBirth": "$nav.bruker.far.person.etternavnvedfoedsel"
        },
        "dateBirth": "$nav.bruker.person.foedselsdato"
      }
    },
    "ChangeInPersonalCircumstances": {
      "previousFamilyName": "$nav.bruker.endringer.gammeltetternavn",
      "dateDeath": "$nav.bruker.endringer.doedsdato",
      "ChangeInLivingArrangements": {
        "newLivingArrangements": {
          "value": [
            "$nav.bruker.endringer.livsforhold.verdi"
          ]
        },
        "dateChange": "$nav.bruker.endringer.livsforhold.startdato"
      },
      "ChangeInFamilyStatus": {
        "newFamilyStatus": {
          "value": [
            "$nav.bruker.endringer.sivilstand.verdi"
          ]
        },
        "dateChange": "$nav.bruker.endringer.sivilstand.startdato"
      },
      "ChangeInGender": {
        "dateChangingAGender": "$nav.bruker.endringer.kjoenn.startdato",
        "newGender": {
          "value": [
            "$nav.bruker.endringer.kjoenn.verdi"
          ]
        }
      },
      "ChangeInNationality": {
        "dateChangeNationality": "$nav.bruker.endringer.startdato",
        "newNationality": {
          "value": [
            "$nav.bruker.endringer.statsborgerskap"
          ]
        }
      },
      "ChangeInPersonalIdentificationNumberInformation": {
        "newPersonalIdentificationNumber": "$nav.bruker.endringer.personpinendringer.nytt",
        "oldPersonalIdentificationNumber": "$nav.bruker.endringer.personpinendringer.gammelt"
      },
      "previousForename": "$nav.bruker.endringer.gammeltfornavn",
      "ChangeInAddress": {
        "Address": {
          "buildingName": "$nav.bruker.endringer.adresse.bygning",
          "country": {
            "value": [
              "$nav.bruker.endringer.adresse.land"
            ]
          },
          "town": "$nav.bruker.endringer.adresse.by",
          "street": "$nav.bruker.endringer.adresse.gate",
          "postalCode": "$nav.bruker.endringer.adresse.postnummer",
          "region": "$nav.bruker.endringer.adresse.region"
        },
        "dateChangeAddress": "$nav.bruker.endringer.adresse.startdato",
        "thePersonHasMovedOutCountryIndicator": {
          "value": [
            "$nav.bruker.endringer.utvandret"
          ]
        }
      }
    }
  }
}