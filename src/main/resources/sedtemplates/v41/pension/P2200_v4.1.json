        "IfPINNotProvidedForEveryInstitutionPleaseProvide": {
          "PlaceBirth": {
            "town": "$nav.ektefelle.person.foedested.by",
            "region": "$nav.ektefelle.person.foedested.region",
            "country": {
              "value": [
                "$nav.ektefelle.person.foedested.land"
              ]
