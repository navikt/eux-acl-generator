          "endDateEmploymentOrSelfEmployment": "$pensjon.bruker.arbeidsforhold[x].sluttdato",
          "intendedRetirementDateFromEmploymentOrSelfEmployment": "$pensjon.bruker.arbeidsforhold[x].planlagtpensjoneringsdato",
