          },
          "fatherFamilyNameAtBirth": "$nav.ektefelle.far.person.etternavnvedfoedsel",
          "forenameFather": "$nav.ektefelle.far.person.fornavn",
          "motherFamilyNameAtBirth": "$nav.ektefelle.mor.person.etternavnvedfoedsel",
          "forenameMother": "$nav.ektefelle.mor.person.fornavn"
        }
      },
      "AdditionalInformationPerson": {
        "nationality": {
          "value": [
            "$nav.ektefelle.person.statsborgerskap[x].land"
          ]
        },
        "previousFamilyName": "$nav.ektefelle.person.tidligereetternavn",
        "previousForename": "$nav.ektefelle.person.tidligerefornavn"
      }
