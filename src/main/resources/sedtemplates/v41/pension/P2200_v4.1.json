    "InformationPayment": {
      "paymentTo": {
        "value": [
          "$nav.bruker.bank.konto.innehaver.rolle"
        ]
      },
      "BankInformation": {
        "accountHolderName": "$nav.bruker.bank.konto.innehaver.navn",
        "SEPAAccount": {
          "IBAN": "$nav.bruker.bank.konto.sepa.iban",
          "BICSWIFT": "$nav.bruker.bank.konto.sepa.swift"
