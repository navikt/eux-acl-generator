              "totalGrossAmountWorkRelatedPension": "$pensjon.ytelser[x].mottasbasertpaaitem[x].totalbruttobeloeparbeidsbasert"
            }
          ]
        }
      ]
    },
    "Spouse": {
      "spouse": {
        "value": [
          "$nav.ektefelle.type"
