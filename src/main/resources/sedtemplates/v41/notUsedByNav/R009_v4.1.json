{
	"R009": {
		"sedGVer": "$sedGVer",
		"sedVer": "$sedVer",
		"LocalCaseNumbers": {
			"LocalCaseNumber": [
				{
					"country": {
						"value": [
							"$nav.eessisak[x].land"
						]
					},
					"caseNumber": "$nav.eessisak[x].saksnummer",
					"Institution": {
						"institutionID": "$nav.eessisak[x].institusjonsid",
						"institutionName": "$nav.eessisak[x].institusjonsnavn"
					}
				}
			]
		},
		"Persons": {
			"Person": [
				{
					"PersonIdentification": {
						"familyName": "$nav.bruker[x].person.etternavn",
						"forename": "$nav.bruker[x].person.fornavn",
						"dateBirth": "$nav.bruker[x].person.foedselsdato",
						"sex": {
							"value": [
								"$nav.bruker[x].person.kjoenn"
							]
						},
						"familyNameAtBirth": "$nav.bruker[x].person.etternavnvedfoedsel",
						"forenameAtBirth": "$nav.bruker[x].person.fornavnvedfoedsel",
						"PINPersonInEachInstitution": {
							"PersonalIdentificationNumber": [
								{
									"country": {
										"value": [
											"$nav.bruker[x].person.pin[x].land"
										]
									},
									"personalIdentificationNumber": "$nav.bruker[x].person.pin[x].identifikator",
									"sector": {
										"value": [
											"$nav.bruker[x].person.pin[x].sektor"
										]
									},
									"Institution": {
										"institutionID": "$nav.bruker[x].person.pin[x].institusjonsid",
										"institutionName": "$nav.bruker[x].person.pin[x].institusjonsnavn"
									}
								}
							]
						},
						"IfPINNotProvidedForEveryInstitutionPleaseProvide": {
							"PlaceBirth": {
								"town": "$nav.bruker[x].person.foedested.by",
								"region": "$nav.bruker[x].person.foedested.region",
								"country": {
									"value": [
										"$nav.bruker[x].person.foedested.land"
									]
								}
							},
							"fatherFamilyNameAtBirth": "$nav.bruker[x].far.person.etternavnvedfoedsel",
							"forenameFather": "$nav.bruker[x].far.person.fornavn",
							"motherFamilyNameAtBirth": "$nav.bruker[x].mor.person.etternavnvedfoedsel",
							"forenameMother": "$nav.bruker[x].mor.person.fornavn"
						}
					},
					"AdditionalInformationAboutPerson": {
						"statusPerson": {
							"value": [
								"$tilbakekreving.bruker[x].status.type"
							]
						},
						"PleaseFillInFollowingIfStatusPersonOther": {
							"otherStatusPerson": "$tilbakekreving.bruker[x].status.annen"
						},
						"nationality": {
							"value": [
								"$nav.bruker[x].person.statsborgerskap[x].land"
							]
						},
						"PreviousFamilyNames": {
							"PreviousFamilyName": [
								{
									"previousFamilyName": "$tilbakekreving.bruker[x].person.tidligereetternavn[x].navn"
								}
							]
						},
						"PreviousForenames": {
							"PreviousForename": [
								{
									"previousForename": "$tilbakekreving.bruker[x].person.tidligerefornavn[x].navn"
								}
							]
						},
						"currentFamilyStatus": {
							"value": [
								"$tilbakekreving.bruker[x].person.tilbakekrevingsivilstand.status"
							]
						},
						"dateDeath": "$nav.bruker[x].person.doedsdato"
					}
				}
			]
		},
		"EntitlementBenefits": {
			"entitlementBenefitsIndicator": {
				"value": [
					"$tilbakekreving.retttilytelser.harretttilytelser"
				]
			},
			"requestHasBeenMadeWithin3MonthsPeriodIndicator": {
				"value": [
					"$tilbakekreving.retttilytelser.anmodning.erfremsattinnentremaaneder"
				]
			}
		},
		"FillInIfEntitlementBenefitsYes": {
			"entitlementArrearsACorrespondingBenefitIndicator": {
				"value": [
					"$tilbakekreving.retttilytelser.harretttiletterbetalingfrasammenlignbareytelser"
				]
			},
			"FillInIfEntitlementArrears": {
				"PayableArrearsPeriod": {
					"startDate": "$tilbakekreving.retttilytelser.etterbetaling.periode.startdato",
					"endDate": "$tilbakekreving.retttilytelser.etterbetaling.periode.sluttdato"
				},
				"ArrearsTotalAmount": {
					"amount": "$tilbakekreving.retttilytelser.etterbetaling.beloep",
					"currency": {
						"value": [
							"$tilbakekreving.retttilytelser.etterbetaling.valuta"
						]
					}
				},
				"amountArrearsCoversFullAmountProvisionalPaymentIndicator": {
					"value": [
						"$tilbakekreving.retttilytelser.etterbetaling.dekkerhelebeloepet"
					]
				}
			}
		},
		"FillInIfEntitlementArrears": {
			"deductionPossiblePeriodicRatesFromOngoingPaymentsIndicator": {
				"value": [
					"$tilbakekreving.retttilytelser.harretttilmotregningiloependeutbetalinger"
				]
			},
			"PleaseFillInFollowingIfDeductionYes": {
				"TypeBenefitsFromWhichDeductionPossible": [
					{
						"TypeBenefitFromWhichDeductionFromOngoing": {
							"typeBenefit": {
								"value": [
									"$tilbakekreving.retttilytelser.motregning.ytelse[x].type"
								]
							},
							"PleaseFillInFollowingIfTypeBenefitOtherBenefit": {
								"typeOtherBenefit": "$tilbakekreving.retttilytelser.motregning.ytelse[x].annen"
							}
						},
						"institutionCompetentForDeductionFromOngoingPayment": {
							"value": [
								"$tilbakekreving.retttilytelser.motregning.ytelse[x].institusjon.type[x]"
							]
						},
						"PeriodicAmount": {
							"frequency": {
								"value": [
									"$tilbakekreving.retttilytelser.motregning.ytelse[x].hyppighet.type"
								]
							},
							"PleaseFillInFollowingIfFrequencyOther": {
								"otherFrequency": "$tilbakekreving.retttilytelser.motregning.ytelse[x].hyppighet.annen"
							},
							"numberPeriodicUnits": "$tilbakekreving.retttilytelser.motregning.ytelse[x].antallperiodeenheter",
							"AmountPerUnit": {
								"amount": "$tilbakekreving.retttilytelser.motregning.ytelse[x].utbetalingperperiode.beloep",
								"currency": {
									"value": [
										"$tilbakekreving.retttilytelser.motregning.ytelse[x].utbetalingperperiode.valuta"
									]
								}
							}
						},
						"FillInIfInstitutionCompetentFor": {
							"OtherInstitutionsCompetentForOngoingPayment": {
								"OtherInstitutionCompetentForOngoingPayment": [
									{
										"institutionID": "$tilbakekreving.retttilytelser.motregning.ytelse[x].annenkompetentinstitusjon[x].institusjonsid",
										"institutionName": "$tilbakekreving.retttilytelser.motregning.ytelse[x].annenkompetentinstitusjon[x].institusjonsnavn"
									}
								]
							}
						}
					}
				]
			}
		},
		"AdditionalInformation": {
			"additionalInformation": "$nav.ytterligereinformasjon"
		}
	}
}
