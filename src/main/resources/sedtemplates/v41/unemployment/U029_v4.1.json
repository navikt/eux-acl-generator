              "familyNameAtBirth": "$dagpenger.refusjonskrav.enkeltkrav[x].endring.bruker.person.etternavnvedfoedsel",
              "forenameAtBirth": "$dagpenger.refusjonskrav.enkeltkrav[x].endring.bruker.person.fornavnvedfoedsel",
              "PINPersonInEachInstitution": {
                "PersonalIdentificationNumber": [
                  {
                    "country": {
                      "value": [
                        "$dagpenger.refusjonskrav.enkeltkrav[x].endring.bruker.person.pin[x].land"
                      ]
                    },
                    "personalIdentificationNumber": "$dagpenger.refusjonskrav.enkeltkrav[x].endring.bruker.person.pin[x].identifikator",
                    "sector": {
                      "value": [
                        "$dagpenger.refusjonskrav.enkeltkrav[x].endring.bruker.person.pin[x].sektor"
                      ]
                    },
                    "Institution": {
                      "institutionID": "$dagpenger.refusjonskrav.enkeltkrav[x].endring.bruker.person.pin[x].institusjonsid",
                      "institutionName": "$dagpenger.refusjonskrav.enkeltkrav[x].endring.bruker.person.pin[x].institusjonsnavn"
                    }
                  }
                ]
              },
              "IfPINNotProvidedForEveryInstitutionPleaseProvide": {
