{
  "U029": {
    "sedGVer": "$sedGVer",
    "sedVer": "$sedVer",
    "LocalCaseNumbers": {
      "LocalCaseNumber": [
        {
          "country": {
            "value": [
              "$nav.eessisak[x].land"
            ]
          },
          "caseNumber": "$nav.eessisak[x].saksnummer",
          "Institution": {
            "institutionID": "$nav.eessisak[x].institusjonsid",
            "institutionName": "$nav.eessisak[x].institusjonsnavn"
          }
        }
      ]
    },
    "GeneralInformation": {
      "reimbursementRequestID": "$dagpenger.refusjonskrav.id",
      "reimbursementContestationID": "$dagpenger.refusjonskrav.bestridelse.id",
      "amendedReimbursementRequestID": "$dagpenger.refusjonskrav.endret.id",
      "UpdatedTotalAmountRequested": {
        "amount": "$dagpenger.refusjonskrav.anmodnettotalbeloep.oppdatert.beloep",
        "currency": {
          "value": [
            "$dagpenger.refusjonskrav.anmodnettotalbeloep.oppdatert.valuta"
          ]
        }
      }
    },
    "IndividualClaims": {
      "IndividualClaim": [
        {
          "reimbursementRequestID": "$dagpenger.refusjonskrav.enkeltkrav[x].refusjonskravid",
          "reimbursementContestationID": "$dagpenger.refusjonskrav.enkeltkrav[x].refusjonskravbestridelseid",
          "amendedReimbursementRequestID": "$dagpenger.refusjonskrav.enkeltkrav[x].refusjonskravendetid",
          "sequentialNumberIndividualClaim": "$dagpenger.refusjonskrav.enkeltkrav[x].loepenummer",
          "contestedIndividualClaimID": "$dagpenger.refusjonskrav.enkeltkrav[x].bestridelse.id",
          "amendedContestedIndividualClaimID": "$dagpenger.refusjonskrav.enkeltkrav[x].endring.id",
          "IndividualClaimStatus": {
            "status": {
              "value": [
                "$dagpenger.refusjonskrav.enkeltkrav[x].status.id"
              ]
            },
            "PleaseFillInFollowingIfStatus6UnderDispute": {
              "reasoning": "$dagpenger.refusjonskrav.enkeltkrav[x].status.omtvistet"
            }
          },
          "Person": {
