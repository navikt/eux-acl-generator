                  "region": "$dagpenger.refusjonskrav.enkeltkrav[x].endring.bruker.person.foedested.region",
                  "country": {
                    "value": [
                      "$dagpenger.refusjonskrav.enkeltkrav[x].endring.bruker.person.foedested.land"
                    ]
                  }
                },
                "fatherFamilyNameAtBirth": "$dagpenger.refusjonskrav.enkeltkrav[x].endring.bruker.far.person.etternavnvedfoedsel",
                "forenameFather": "$dagpenger.refusjonskrav.enkeltkrav[x].endring.bruker.far.person.fornavn",
                "motherFamilyNameAtBirth": "$dagpenger.refusjonskrav.enkeltkrav[x].endring.bruker.mor.person.etternavnvedfoedsel",
                "forenameMother": "$dagpenger.refusjonskrav.enkeltkrav[x].endring.bruker.mor.person.fornavn"
              }
            },
            "AdditionalInformationPerson": {
              "nationality": {
                "value": [
                  "$dagpenger.refusjonskrav.enkeltkrav[x].endring.bruker.person.statsborgerskap[x].land"
                ]
              }
            }
          },
          "InstitutionWhichCertifiedInsuranceRecord": {
            "institutionID": "$dagpenger.refusjonskrav.enkeltkrav[x].endring.attestererhistorikk.institusjon.id",
            "institutionName": "$dagpenger.refusjonskrav.enkeltkrav[x].endring.attestererhistorikk.institusjon.navn"
          },
          "WorkingPeriodsConsidered": {
            "WorkingPeriodConsidered": [
              {
                "startDate": "$dagpenger.refusjonskrav.enkeltkrav[x].endring.arbeidsperiode[x].startdato",
                "endDate": "$dagpenger.refusjonskrav.enkeltkrav[x].endring.arbeidsperiode[x].sluttdato"
              }
            ]
          },
          "ReimbursementPeriod": {
            "startDate": "$dagpenger.refusjonskrav.enkeltkrav[x].endring.refusjonsperiode.startdato",
            "endDate": "$dagpenger.refusjonskrav.enkeltkrav[x].endring.refusjonsperiode.sluttdato"
          },
          "lastPaymentDate": "$dagpenger.refusjonskrav.enkeltkrav[x].endring.sisteutbetalingsdato",
          "RequestedAmountForReimbursement": {
            "amount": "$dagpenger.refusjonskrav.enkeltkrav[x].endring.anmodnetrefusjonsbeloep.beloep",
            "currency": {
              "value": [
                "$dagpenger.refusjonskrav.enkeltkrav[x].endring.anmodnetrefusjonsbeloep.valuta"
              ]
            }
          }
        }
      ]
    }
