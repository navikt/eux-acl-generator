              "forename": "$dagpenger.refusjonskrav.enkeltkrav[x].endring.bruker.person.fornavn",
              "dateBirth": "$dagpenger.refusjonskrav.enkeltkrav[x].endring.bruker.person.foedselsdato",
              "sex": {
                "value": [
                  "$dagpenger.refusjonskrav.enkeltkrav[x].endring.bruker.person.kjoenn"
                ]
