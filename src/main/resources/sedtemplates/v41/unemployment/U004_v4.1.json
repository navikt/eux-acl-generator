  {
  "U004": {
    "sedGVer": "$sedGVer",
    "sedVer": "$sedVer",
    "LocalCaseNumbers": {
      "LocalCaseNumber": [
        {
          "country": {
            "value": [
              "$nav.eessisak[x].land"
            ]
          },
          "caseNumber": "$nav.eessisak[x].saksnummer",
          "Institution": {
            "institutionID": "$nav.eessisak[x].institusjonsid",
            "institutionName": "$nav.eessisak[x].institusjonsnavn"
          }
        }
      ]
    },
    "Person": {
      "PersonIdentification": {
        "familyName": "$nav.bruker.person.etternavn",
        "forename": "$nav.bruker.person.fornavn",
        "dateBirth": "$nav.bruker.person.foedselsdato",
        "sex": {
          "value": [
            "$nav.bruker.person.kjoenn"
          ]
        },
        "familyNameAtBirth": "$nav.bruker.person.etternavnvedfoedsel",
        "forenameAtBirth": "$nav.bruker.person.fornavnvedfoedsel",
        "PINPersonInEachInstitution": {
          "PersonalIdentificationNumber": [
            {
              "country": {
                "value": [
                  "$nav.bruker.person.pin[x].land"
                ]
              },
              "personalIdentificationNumber": "$nav.bruker.person.pin[x].identifikator",
              "sector": {
                "value": [
                  "$nav.bruker.person.pin[x].sektor"
                ]
              },
              "Institution": {
                "institutionID": "$nav.bruker.person.pin[x].institusjonsid",
                "institutionName": "$nav.bruker.person.pin[x].institusjonsnavn"
              }
            }
          ]
        },
        "IfPINNotProvidedForEveryInstitutionPleaseProvide": {
          "PlaceBirth": {
            "town": "$nav.bruker.person.foedested.by",
            "region": "$nav.bruker.person.foedested.region",
            "country": {
              "value": [
                "$nav.bruker.person.foedested.land"
              ]
            }
          },
          "fatherFamilyNameAtBirth": "$nav.bruker.far.person.etternavnvedfoedsel",
          "forenameFather": "$nav.bruker.far.person.fornavn",
          "motherFamilyNameAtBirth": "$nav.bruker.mor.person.etternavnvedfoedsel",
          "forenameMother": "$nav.bruker.mor.person.fornavn"
        }
      },
      "AdditionalInformationPerson": {
        "nationality": {
          "value": [
            "$nav.bruker.person.statsborgerskap[x].land"
          ]
        }
      }
    },
    "ReferencePeriod": {
      "FixedPeriod": {
        "startDate": "$dagpenger.anmodningominformasjon.anmodningsperiode.fastperiode.startdato",
        "endDate": "$dagpenger.anmodningominformasjon.anmodningsperiode.fastperiode.sluttdato"
      },
      "OpenPeriod": {
        "typeOpenPeriod": {
          "value": [
            "$dagpenger.anmodningominformasjon.anmodningsperiode.aapenperiode.type"
          ]
        },
        "startDate": "$dagpenger.anmodningominformasjon.anmodningsperiode.aapenperiode.startdato"
      }
    },
    "EmploymentOrSelfEmploymentInformation": {
      "EmploymentOrSelfEmploymentInformation": [
        {
          "Period": {
            "FixedPeriod": {
              "startDate": "$dagpenger.anmodningominformasjon.svar.loennsopplysninger[x].periode.fastperiode.startdato",
              "endDate": "$dagpenger.anmodningominformasjon.svar.loennsopplysninger[x].periode.fastperiode.sluttdato"
            },
            "OpenPeriod": {
              "typeOpenPeriod": {
                "value": [
                  "$dagpenger.anmodningominformasjon.svar.loennsopplysninger[x].periode.aapenperiode.type"
                ]
              },
              "startDate": "$dagpenger.anmodningominformasjon.svar.loennsopplysninger[x].periode.aapenperiode.startdato"
            }
          },
          "periodOf": {
            "value": [
              "$dagpenger.anmodningominformasjon.svar.loennsopplysninger[x].ansettelsestype"
            ]
          },
          "EarningsDetails": {
            "EarningsDetail": [
              {
                "earningsType": {
                  "value": [
                    "$dagpenger.anmodningominformasjon.svar.loennsopplysninger[x].inntekt[x].type.id"
                  ]
                },
                "Earnings": {
                  "amount": "$dagpenger.anmodningominformasjon.svar.loennsopplysninger[x].inntekt[x].beloep",
                  "currency": {
                    "value": [
                      "$dagpenger.anmodningominformasjon.svar.loennsopplysninger[x].inntekt[x].valuta"
                    ]
                  }
                },
                "PleaseFillInFollowingIfEarningsTypeOtherPayment": {
                  "informationAboutOtherCompensation": "$dagpenger.anmodningominformasjon.svar.loennsopplysninger[x].inntekt[x].type.annen"
                }
              }
            ]
          },
          "RequestedAdditionalDetails": {
            "numberHoursWorked": "$dagpenger.anmodningominformasjon.svar.loennsopplysninger[x].antallarbeidstimer",
            "numberDaysWorked": "$dagpenger.anmodningominformasjon.svar.loennsopplysninger[x].antallarbeidsdager"
          }
        }
      ]
    }
  }
}