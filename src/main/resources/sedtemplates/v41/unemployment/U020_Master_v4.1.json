{
  "U020_Master": {
    "sedGVer": "$sedGVer",
    "sedVer": "$sedVer",
    "LocalCaseNumbers": {
      "LocalCaseNumber": [
        {
          "country": {
            "value": [
              "$nav.eessisak[x].land"
            ]
          },
          "caseNumber": "$nav.eessisak[x].saksnummer",
          "Institution": {
            "institutionID": "$nav.eessisak[x].institusjonsid",
            "institutionName": "$nav.eessisak[x].institusjonsnavn"
          }
        }
      ]
    },
    "GeneralInformation": {
      "reimbursementRequestID": "$dagpenger.refusjonskrav.id",
      "numberIndividualClaims": "$dagpenger.refusjonskrav.antallkrav",
      "TotalAmountRequested": {
        "amount": "$dagpenger.refusjonskrav.anmodnettotalbeloep.beloep",
        "currency": {
          "value": [
            "$dagpenger.refusjonskrav.anmodnettotalbeloep.valuta"
          ]
        }
      },
      "BankInformation": {
        "SEPABankDetails": {
          "IBAN": "$dagpenger.refusjonskrav.bank.konto.sepa.iban",
          "BICSWIFT": "$dagpenger.refusjonskrav.bank.konto.sepa.swift"
        },
        "bankTransferSubjectOrTransactionReference": "$dagpenger.refusjonskrav.bank.overfoering.emneellerreferanse"
      }
    }
  }
}
